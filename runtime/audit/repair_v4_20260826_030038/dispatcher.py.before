"""E-ZZIO Central Dispatcher.

Contrat compatible avec EzzioMasterOrchestrator.
Cloud-Only strict pour Discord / force_cloud.
"""

from typing import Any, Dict, Tuple

from core.cloud_brain_broker import cloud_chat


TARGET_CLOUD_MODEL = "gemini-3.5-flash-lite"


class EzzioDispatcher:
    """Gestionnaire central de routage E-ZZIO."""

    def __init__(self) -> None:
        self.cloud_only = True
        self.target_cloud_model = TARGET_CLOUD_MODEL

    def select_organ(
        self,
        prompt: str,
    ) -> Tuple[str, Dict[str, Any], int, list]:
        """
        Sélection déterministe de l'organe.

        Le contexte Cloud/Discord reste souverain.
        """

        organ_info = {
            "label": "Souverain",
            "organ": "presence",
            "priority": 10,
            "mode": "cloud_only",
            "provider": "gemini",
        }

        return (
            "presence",
            organ_info,
            100,
            ["gemini_cloud_only"],
        )

    def select_model_for_speed(
        self,
        organ_info: dict,
        speed: str = "fast",
    ) -> str:
        """
        Retourne le modèle effectivement autorisé.

        Dans le canal Cloud-Only, il n'existe qu'un modèle.
        """

        return self.target_cloud_model

    async def route_detailed_async(
        self,
        text: str,
        speed: str = "fast",
        session_id: str = "",
        system_prompt: str = "",
        force_cloud: bool = False,
    ) -> str:
        """
        Routage détaillé compatible avec ezzio_master.py.

        IMPORTANT :
        Cette méthode ne déclenche jamais de fallback local
        lorsqu'un canal Cloud-Only est demandé.
        """

        result = cloud_chat(
            text=text,
            session_id=session_id,
            system_prompt=system_prompt,
            speed=speed,
            provider="gemini",
        )

        if not result.get("ok", False):
            return result.get(
                "response",
                "[FAIL-CLOSED] Échec du routage Cloud."
            )

        return result.get(
            "response",
            result.get("answer", ""),
        )

    async def dispatch_async(
        self,
        text: str,
        session_id: str = "",
        system_prompt: str = "",
        speed: str = "fast",
        force_cloud: bool = False,
    ) -> Dict[str, Any]:
        """
        Interface asynchrone moderne.
        """

        is_discord = str(session_id or "").startswith(
            "disc_user_"
        )

        cloud_required = (
            self.cloud_only
            and (is_discord or force_cloud)
        )

        if cloud_required:
            result = cloud_chat(
                text=text,
                session_id=session_id,
                system_prompt=system_prompt,
                speed=speed,
                provider="gemini",
            )

            return result

        result = cloud_chat(
            text=text,
            session_id=session_id,
            system_prompt=system_prompt,
            speed=speed,
            provider="gemini",
        )

        return result

    def dispatch(
        self,
        text: str,
        session_id: str = "",
        system_prompt: str = "",
        speed: str = "fast",
        force_cloud: bool = False,
    ) -> Dict[str, Any]:
        """
        Interface synchrone historique.

        Elle reste Cloud-Only.
        """

        is_discord = str(session_id or "").startswith(
            "disc_user_"
        )

        if is_discord or force_cloud:
            return cloud_chat(
                text=text,
                session_id=session_id,
                system_prompt=system_prompt,
                speed=speed,
                provider="gemini",
            )

        return cloud_chat(
            text=text,
            session_id=session_id,
            system_prompt=system_prompt,
            speed=speed,
            provider="gemini",
        )


ezzio_dispatcher = EzzioDispatcher()


def dispatch(
    text: str,
    session_id: str = "",
    system_prompt: str = "",
    speed: str = "fast",
    force_cloud: bool = False,
) -> Dict[str, Any]:
    return ezzio_dispatcher.dispatch(
        text,
        session_id=session_id,
        system_prompt=system_prompt,
        speed=speed,
        force_cloud=force_cloud,
    )
