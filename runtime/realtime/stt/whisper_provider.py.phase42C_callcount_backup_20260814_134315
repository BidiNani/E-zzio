from __future__ import annotations

import time
from typing import Any, Dict

import numpy as np

from .provider import ISttProvider, SttResult


class WhisperSttProvider(ISttProvider):

    def __init__(
        self,
        model_size: str = "tiny",
        device: str = "cpu",
        compute_type: str = "int8",
        language: str = "fr",
        beam_size: int = 1,
    ):
        self.model_size = model_size
        self.device = device
        self.compute_type = compute_type
        self.language = language
        self.beam_size = int(beam_size)

        if self.beam_size < 1:
            raise ValueError("beam_size must be >= 1.")

        self._model = None
        self._load_latency_ms = None

    def _ensure_model(self):

        if self._model is not None:
            return

        from faster_whisper import WhisperModel

        t0 = time.perf_counter()

        self._model = WhisperModel(
            self.model_size,
            device=self.device,
            compute_type=self.compute_type,
        )

        self._load_latency_ms = (
            time.perf_counter() - t0
        ) * 1000.0

    async def transcribe(
        self,
        audio: np.ndarray,
        sample_rate: int,
    ) -> SttResult:

        if audio is None:
            raise ValueError("Audio cannot be None.")

        audio = np.asarray(
            audio,
            dtype=np.float32,
        ).reshape(-1)

        if audio.size == 0:
            raise ValueError("Empty audio rejected.")

        if sample_rate != 16000:
            raise ValueError(
                f"Invalid sample rate: {sample_rate}. "
                "Expected 16000 Hz."
            )

        self._ensure_model()

        started = time.perf_counter()

        segments, info = self._model.transcribe(
            audio,
            language=self.language,
            vad_filter=True,
            beam_size=self.beam_size,
        )

        text_parts = []

        for segment in segments:
            text = segment.text.strip()

            if text:
                text_parts.append(text)

        text = " ".join(text_parts).strip()

        latency_ms = (
            time.perf_counter() - started
        ) * 1000.0

        confidence = 0.0

        if text:
            confidence = 1.0

        provenance: Dict[str, Any] = {
            "backend": "faster-whisper",
            "provider": "WhisperSttProvider",
            "model_size": self.model_size,
            "device": self.device,
            "compute_type": self.compute_type,
            "language": self.language,
            "beam_size": self.beam_size,
            "sample_rate": sample_rate,
            "samples": int(audio.size),
            "model_load_latency_ms": self._load_latency_ms,
            "no_mock_fallback": True,
        }

        return SttResult(
            text=text,
            confidence=confidence,
            duration_s=audio.size / float(sample_rate),
            latencies={
                "stt_exec_ms": latency_ms,
            },
            provenance=provenance,
        )