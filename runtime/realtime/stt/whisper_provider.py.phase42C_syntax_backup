import time
from typing import Optional

import numpy as np

from .provider import ISttProvider, SttResult


class WhisperSttProvider(ISttProvider):
    """
    E-ZZIO Phase 4.2-C — Real local STT provider.

    Backend:
        faster-whisper / CTranslate2

    Fail-closed:
        No silent fallback to MockSTT.

    The provider accepts normalized float32 PCM
    and preserves the ISttProvider contract.
    """

    def __init__(
        self,
        model_size: str = "tiny",
        language: str = "fr",
        device: str = "cpu",
        compute_type: str = "int8",
        beam_size: int = 1,
    ):
        self.model_size = model_size
        self.language = language
        self.device = device
        self.compute_type = compute_type
        self.beam_size = beam_size

        self.call_count = 0
        self._model = None

    def _load_model(self):

        if self._model is not None:
            return

        try:
            from faster_whisper import WhisperModel
        except ImportError as exc:
            raise RuntimeError(
                "REAL STT UNAVAILABLE: faster-whisper is not installed. "
                "No MockSTT fallback is permitted."
            ) from exc

        self._model = WhisperModel(
            self.model_size,
            device=self.device,
            compute_type=self.compute_type,
        )

    @staticmethod
    def _validate_audio(
        audio: np.ndarray,
        sample_rate: int,
    ) -> np.ndarray:

        if audio is None:
            raise ValueError("Audio is None.")

        if sample_rate != 16000:
            raise ValueError(
                f"Unsupported sample rate: {sample_rate}. "
                "Phase 4.2-C requires 16000 Hz."
            )

        pcm = np.asarray(
            audio,
            dtype=np.float32
        ).reshape(-1)

        if pcm.size == 0:
            raise ValueError(
                "Cannot transcribe empty audio."
            )

        if not np.isfinite(pcm).all():
            raise ValueError(
                "Audio contains NaN or infinite values."
            )

        max_abs = float(
            np.max(np.abs(pcm))
        )

        if max_abs > 1.0:
            pcm = pcm / max_abs

        return np.ascontiguousarray(
            pcm,
            dtype=np.float32
        )

    async def transcribe(
        self,
        audio: np.ndarray,
        sample_rate: int
    ) -> SttResult:

        started = time.perf_counter()

        pcm = self._validate_audio(
            audio,
            sample_rate
        )

        self._load_model()

        self.call_count += 1

        segments, info = self._model.transcribe(
            pcm,
            language=self.language,
            beam_size=self.beam_size,
            vad_filter=False,
        )

        parts = []
        segment_count = 0

        confidence_values = []

        for segment in segments:

            text = segment.text.strip()

            if text:
                parts.append(text)

            segment_count += 1

            avg_logprob = getattr(
                segment,
                "avg_logprob",
                None
            )

            if avg_logprob is not None:
                confidence_values.append(
                    float(avg_logprob)
                )

        text = " ".join(parts).strip()

        elapsed_ms = (
            time.perf_counter() - started
        ) * 1000.0

        duration_s = (
            len(pcm) / float(sample_rate)
        )

        if confidence_values:
            confidence = max(
                0.0,
                min(
                    1.0,
                    float(
                        np.mean(
                            confidence_values
                        )
                    ) + 1.0
                )
            )
        else:
            confidence = 0.0

        return SttResult(
            text=text,
            confidence=confidence,
            duration_s=duration_s,
            latencies={
                "stt_exec_ms": elapsed_ms
            },
            provenance={
                "provider": "WhisperSttProvider",
                "backend": "faster-whisper",
                "model_size": self.model_size,
                "language": self.language,
                "device": self.device,
                "compute_type": self.compute_type,
                "sample_rate": sample_rate,
                "samples": len(pcm),
                "segment_count": segment_count,
                "call_index": self.call_count,
                "model_info_language": getattr(
                    info,
                    "language",
                    None
                ),
                "model_info_language_probability": getattr(
                    info,
                    "language_probability",
                    None
                ),
            },
        }