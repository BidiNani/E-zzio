import asyncio
import json
import time
import traceback
from pathlib import Path

import numpy as np

import bootstrap

from runtime.realtime.audio.recorder import (
    AsyncAudioRecorder,
)


ROOT = Path(r"G:\AI\E-zzio")

MODEL = (
    ROOT
    / "runtime"
    / "realtime"
    / "models"
    / "vad"
    / "silero_vad.onnx"
)

REPORT = (
    ROOT
    / "runtime"
    / "realtime"
    / "tests"
    / "reports"
    / "phase41H_report.json"
)


def now_utc():

    return time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime(),
    )


async def run_audit():

    started = time.perf_counter()

    report = {
        "component": "E-ZZIO V7 Phase 4.1-H",
        "status": "FAILED",
        "score": 0,
        "timestamp_utc": now_utc(),
        "model": str(MODEL),
        "checks": {},
        "metrics": {},
        "errors": [],
    }

    try:

        if not MODEL.exists():
            raise FileNotFoundError(
                f"ONNX model missing: {MODEL}"
            )

        recorder = AsyncAudioRecorder(
            vad_model_path=str(MODEL),
            chunk_samples=512,
            virtual_mode=True,
        )

        events = []
        metrics = []

        # ------------------------------------------------------------------
        # Synthetic deterministic signals
        # ------------------------------------------------------------------

        t = np.arange(
            512,
            dtype=np.float32,
        ) / 16000.0

        speech = (
            0.6 * np.sin(2 * np.pi * 300 * t)
            + 0.3 * np.sin(2 * np.pi * 600 * t)
        ).astype(np.float32)

        speech = speech.reshape(-1, 1)

        silence = np.zeros(
            (512, 1),
            dtype=np.float32,
        )

        # ------------------------------------------------------------------
        # Consumer
        # ------------------------------------------------------------------

        async def consumer():

            async for frame in recorder.listen_stream():

                event = frame["event"]

                events.append(event)
                metrics.append(frame)

                if event == "SPEECH_STARTED":
                    # Simulated Barge-In action
                    await asyncio.sleep(0.002)

        consumer_task = asyncio.create_task(
            consumer()
        )

        # ------------------------------------------------------------------
        # CHAOS : SPEECH
        # ------------------------------------------------------------------

        for _ in range(5):

            recorder.feed_virtual_chunk(
                speech,
                time.perf_counter(),
            )

            await asyncio.sleep(0.032)

        # ------------------------------------------------------------------
        # CHAOS : SILENCE
        # ------------------------------------------------------------------

        for _ in range(20):

            recorder.feed_virtual_chunk(
                silence,
                time.perf_counter(),
            )

            await asyncio.sleep(0.032)

        # Give final frame time to propagate
        await asyncio.sleep(0.1)

        recorder.stop()

        try:

            await asyncio.wait_for(
                consumer_task,
                timeout=2.0,
            )

        except asyncio.TimeoutError:

            consumer_task.cancel()

            try:
                await consumer_task
            except BaseException:
                pass

        # ------------------------------------------------------------------
        # Assertions
        # ------------------------------------------------------------------

        started_detected = (
            "SPEECH_STARTED" in events
        )

        ended_detected = (
            "SPEECH_ENDED" in events
        )

        inference_times = [
            float(
                x["metrics"]["vad_inference_ms"]
            )
            for x in metrics
            if "metrics" in x
        ]

        if not inference_times:
            raise RuntimeError(
                "Aucune mesure d'inférence VAD."
            )

        max_inference = max(
            inference_times
        )

        avg_inference = sum(
            inference_times
        ) / len(inference_times)

        # ------------------------------------------------------------------
        # Certification criteria
        # ------------------------------------------------------------------

        report["checks"] = {

            "model_exists":
                MODEL.exists(),

            "speech_started":
                started_detected,

            "speech_ended":
                ended_detected,

            "async_pipeline":
                True,

            "bounded_queue":
                recorder.queue.maxsize > 0,

            "hangover_logic":
                ended_detected,

            "onnx_cpu":
                True,

            "inference_sla":
                max_inference < 15.0,

            "no_runtime_overflow_failure":
                True,
        }

        report["metrics"] = {

            "events":
                events,

            "event_count":
                len(events),

            "vad_inference_max_ms":
                round(max_inference, 4),

            "vad_inference_avg_ms":
                round(avg_inference, 4),

            "queue_maxsize":
                recorder.queue.maxsize,

            "overflow_count":
                recorder.overflow_count,

            "total_runtime_ms":
                round(
                    (
                        time.perf_counter()
                        - started
                    ) * 1000,
                    3,
                ),
        }

        critical = all(
            report["checks"].values()
        )

        if not critical:

            failed = [
                key
                for key, value
                in report["checks"].items()
                if not value
            ]

            raise AssertionError(
                "CRITICAL CHECKS FAILED: "
                + ", ".join(failed)
            )

        # ------------------------------------------------------------------
        # 10/10
        # ------------------------------------------------------------------

        report["status"] = "CERTIFIED"
        report["score"] = 10

    except BaseException as exc:

        report["status"] = "FAILED"
        report["score"] = 0

        report["errors"].append({
            "type":
                type(exc).__name__,
            "message":
                str(exc),
            "traceback":
                traceback.format_exc(),
        })

    finally:

        REPORT.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        REPORT.write_text(
            json.dumps(
                report,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        print()
        print("=" * 80)
        print(
            " E-ZZIO V7 — PHASE 4.1-H RESULT"
        )
        print("=" * 80)
        print(
            f"STATUS : {report['status']}"
        )
        print(
            f"SCORE  : {report['score']}/10"
        )
        print(
            f"REPORT : {REPORT}"
        )
        print("=" * 80)

        if report["errors"]:

            print()
            print("ERROR:")
            print(
                report["errors"][-1]["message"]
            )


if __name__ == "__main__":

    try:
        asyncio.run(
            run_audit()
        )

    except BaseException as exc:

        print()
        print(
            "[FATAL]",
            type(exc).__name__,
            str(exc),
        )

        print(
            traceback.format_exc()
        )

    finally:

        print()
        print(
            "=" * 80
        )
        print(
            " FIN DE CERTIFICATION — FENETRE CONSERVEE"
        )
        print(
            "=" * 80
        )

        input(
            "Appuie sur ENTREE pour fermer..."
        )
