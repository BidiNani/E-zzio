if __name__ == "__main__":

    exit_code = 1

    try:

        asyncio.run(
            run_audit()
        )

        if REPORT.exists():

            final_report = json.loads(
                REPORT.read_text(
                    encoding="utf-8"
                )
            )

            if (
                final_report.get(
                    "status"
                )
                == "CERTIFIED"
                and
                int(
                    final_report.get(
                        "score",
                        0,
                    )
                )
                == 10
            ):

                exit_code = 0

    except BaseException as exc:

        print()
        print(
            "[FATAL]",
            type(exc).__name__,
            str(exc),
        )

        print(
            traceback.format_exc()
        )

        exit_code = 1

    raise SystemExit(
        exit_code
    )