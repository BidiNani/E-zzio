def utc_now():
    return time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime(),
    )


def sha256_file(path):
    h = hashlib.sha256()

    with open(path, "rb") as f:
        while True:
            block = f.read(1024 * 1024)

            if not block:
                break

            h.update(block)

    return h.hexdigest().upper()


def percentile(values, p):
    if not values:
        return 999.0

    values = sorted(float(x) for x in values)

    if len(values) == 1:
        return values[0]

    index = (len(values) - 1) * (p / 100.0)

    lower = int(index)
    upper = min(
        lower + 1,
        len(values) - 1,
    )

    if lower == upper:
        return values[lower]

    fraction = index - lower

    return (
        values[lower]
        + (
            values[upper]
            - values[lower]
        )
        * fraction
    )


def resample_audio_in_ram(
    audio_data,
    orig_sr,
    target_sr=16000,
):
    """
    IMPORTANT:
    Resampling happens ONLY in RAM.
    No source file is written.
    """

    audio_data = np.asarray(
        audio_data,
        dtype=np.float32,
    )

    if orig_sr == target_sr:
        return audio_data

    try:
        from scipy.signal import resample_poly

        gcd = math.gcd(
            orig_sr,
            target_sr,
        )

        up = target_sr // gcd
        down = orig_sr // gcd

        result = resample_poly(
            audio_data,
            up,
            down,
        )

        return result.astype(
            np.float32
        )

    except ImportError:

        duration = (
            len(audio_data)
            / float(orig_sr)
        )

        target_length = max(
            1,
            int(
                round(
                    duration
                    * target_sr
                )
            ),
        )

        indices = np.linspace(
            0,
            len(audio_data) - 1,
            target_length,
        )

        result = np.interp(
            indices,
            np.arange(
                len(audio_data)
            ),
            audio_data,
        )

        return result.astype(
            np.float32
        )


def load_real_wav_read_only(path):
    """
    Loads the REAL fixture.
    Never opens it in write mode.
    """

    if not path.exists():
        raise FileNotFoundError(
            f"REAL WAV FIXTURE MISSING: {path}"
        )

    sha_before = sha256_file(path)

    with wave.open(
        str(path),
        "rb",
    ) as wf:

        channels = wf.getnchannels()
        sample_width = wf.getsampwidth()
        sample_rate = wf.getframerate()
        frames_count = wf.getnframes()

        raw = wf.readframes(
            frames_count
        )

    if sample_width == 2:

        audio = (
            np.frombuffer(
                raw,
                dtype=np.int16,
            )
            .astype(np.float32)
            / 32768.0
        )

    elif sample_width == 4:

        audio = np.frombuffer(
            raw,
            dtype=np.float32,
        )

    else:

        raise RuntimeError(
            "Unsupported WAV sample width: "
            f"{sample_width}"
        )

    if channels > 1:

        audio = audio.reshape(
            -1,
            channels,
        ).mean(axis=1)

    audio_16k = resample_audio_in_ram(
        audio,
        sample_rate,
        16000,
    )

    sha_after_load = sha256_file(path)

    return (
        audio_16k,
        {
            "path": str(path),
            "channels": channels,
            "sample_width": sample_width,
            "source_sample_rate": sample_rate,
            "target_sample_rate": 16000,
            "frames": frames_count,
            "duration_s": round(
                frames_count
                / sample_rate,
                6,
            ),
            "sha256_before": sha_before,
            "sha256_after_load": sha_after_load,
            "source_untouched_during_load": (
                sha_before
                == sha_after_load
            ),
            "resampling_policy":
                "IN_MEMORY_ONLY",
        },
    )


# ============================================================================
# AUDIT
# ============================================================================

async def run_audit():

    started = time.perf_counter()

    report = {
        "component":
            "E-ZZIO V7 Phase 4.1-H",

        "certification":
            "INDUSTRIAL",

        "status":
            "FAILED",

        "score":
            0,

        "timestamp_utc":
            utc_now(),

        "model":
            str(MODEL),

        "checks": {},

        "metrics": {},

        "evidence": {},

        "errors": [],
    }

    recorders = []

    try:

        # ==================================================================
        # MODEL
        # ==================================================================

        if not MODEL.exists():

            raise FileNotFoundError(
                f"ONNX model missing: {MODEL}"
            )

        recorder = AsyncAudioRecorder(
            vad_model_path=str(MODEL),
            chunk_samples=512,
            virtual_mode=True,
        )

        recorders.append(
            recorder
        )

        signature = (
            recorder.vad.engine.signature()
        )

        report["evidence"][
            "onnx_signature"
        ] = signature

        inputs = signature.get(
            "inputs",
            [],
        )

        state_contract = any(
            "state"
            in str(
                item.get(
                    "name",
                    "",
                )
            ).lower()
            for item in inputs
        )

        # ==================================================================
        # REAL WAV
        # ==================================================================

        (
            audio_16k,
            speech_meta,
        ) = load_real_wav_read_only(
            WAV
        )

        report["evidence"][
            "speech_fixture_metadata"
        ] = speech_meta

        report["evidence"][
            "resampling_policy"
        ] = "IN_MEMORY_ONLY"

        # ==================================================================
        # SILENCE CONTRACT
        # ==================================================================

        silence = np.zeros(
            (512, 1),
            dtype=np.float32,
        )

        recorder.vad.reset()

        silence_frame = (
            recorder.vad.process_chunk(
                silence,
                time.perf_counter(),
            )
        )

        silence_probability = float(
            silence_frame[
                "probability"
            ]
        )

        silence_contract = (
            0.0
            <= silence_probability
            <= 1.0
            and silence_frame[
                "event"
            ]
            == "SILENCE"
        )

        # ==================================================================
        # PERFORMANCE
        # ==================================================================

        inference_times = []

        recorder.vad.reset()

        for _ in range(100):

            t0 = time.perf_counter()

            recorder.vad.process_chunk(
                silence,
                t0,
            )

            inference_times.append(
                (
                    time.perf_counter()
                    - t0
                )
                * 1000.0
            )

        p50 = percentile(
            inference_times,
            50,
        )

        p95 = percentile(
            inference_times,
            95,
        )

        p99 = percentile(
            inference_times,
            99,
        )

        max_ms = max(
            inference_times
        )

        # ==================================================================
        # REAL SPEECH
        # ==================================================================

        recorder.vad.reset()

        speech_events = []

        speech_probabilities = []

        chunk_size = 512

        usable_length = (
            len(audio_16k)
            // chunk_size
        ) * chunk_size

        if usable_length <= 0:

            raise RuntimeError(
                "Real WAV produced no usable 512-sample chunks."
            )

        for offset in range(
            0,
            usable_length,
            chunk_size,
        ):

            chunk = audio_16k[
                offset:
                offset + chunk_size
            ]

            chunk = chunk.reshape(
                -1,
                1,
            )

            frame = (
                recorder.vad.process_chunk(
                    chunk,
                    time.perf_counter(),
                )
            )

            event = frame[
                "event"
            ]

            probability = float(
                frame[
                    "probability"
                ]
            )

            speech_events.append(
                event
            )

            speech_probabilities.append(
                probability
            )

        real_speech_started = (
            "SPEECH_STARTED"
            in speech_events
        )

        # ==================================================================
        # FORCE SPEECH END
        # ==================================================================

        silence_frame = (
            np.zeros(
                (chunk_size, 1),
                dtype=np.float32,
            )
        )

        for _ in range(30):

            frame = (
                recorder.vad.process_chunk(
                    silence_frame,
                    time.perf_counter(),
                )
            )

            speech_events.append(
                frame["event"]
            )

            speech_probabilities.append(
                float(
                    frame[
                        "probability"
                    ]
                )
            )

        real_speech_ended = (
            "SPEECH_ENDED"
            in speech_events
        )

        speech_probability_max = (
            max(speech_probabilities)
            if speech_probabilities
            else None
        )

        # ==================================================================
        # ASYNC PIPELINE
        # ==================================================================

        async_recorder = (
            AsyncAudioRecorder(
                vad_model_path=str(MODEL),
                chunk_samples=512,
                virtual_mode=True,
            )
        )

        recorders.append(
            async_recorder
        )

        async_events = []

        async def consumer():

            async for frame in (
                async_recorder.listen_stream()
            ):

                async_events.append(
                    frame["event"]
                )

        consumer_task = asyncio.create_task(
            consumer()
        )

        await asyncio.sleep(
            0.05
        )

        for _ in range(20):

            async_recorder.feed_virtual_chunk(
                silence,
                time.perf_counter(),
            )

            await asyncio.sleep(
                0.002
            )

        async_recorder.stop()

        try:

            await asyncio.wait_for(
                consumer_task,
                timeout=2.0,
            )

        except asyncio.TimeoutError:

            consumer_task.cancel()

            try:
                await consumer_task
            except BaseException:
                pass

        async_pipeline_valid = (
            len(async_events) > 0
        )

        # ==================================================================
        # CANCELLATION
        # ==================================================================

        cancel_recorder = (
            AsyncAudioRecorder(
                vad_model_path=str(MODEL),
                chunk_samples=512,
                virtual_mode=True,
            )
        )

        recorders.append(
            cancel_recorder
        )

        cancel_task = asyncio.create_task(
            cancel_recorder
            .listen_stream()
            .__anext__()
        )

        await asyncio.sleep(
            0.02
        )

        cancel_task.cancel()

        cancellation_valid = False

        try:

            await cancel_task

        except BaseException:

            cancellation_valid = True

        cancel_recorder.stop()

        # ==================================================================
        # OVERFLOW
        # ==================================================================

        overflow_recorder = (
            AsyncAudioRecorder(
                vad_model_path=str(MODEL),
                chunk_samples=512,
                virtual_mode=True,
            )
        )

        recorders.append(
            overflow_recorder
        )

        for _ in range(100):

            overflow_recorder.feed_virtual_chunk(
                silence,
                time.perf_counter(),
            )

        queue_maxsize = (
            overflow_recorder
            .queue
            .maxsize
        )

        queue_size = (
            overflow_recorder
            .queue
            .qsize()
        )

        overflow_count = (
            overflow_recorder
            .overflow_count
        )

        overflow_valid = (
            queue_maxsize > 0
            and queue_size
            <= queue_maxsize
            and overflow_count >= 0
        )

        overflow_recorder.stop()

        # ==================================================================
        # SHA SOURCE AFTER ALL READ OPERATIONS
        # ==================================================================

        source_sha_after = sha256_file(
            WAV
        )

        source_audio_untouched = (
            speech_meta[
                "sha256_before"
            ]
            == source_sha_after
        )

        # ==================================================================
        # CHECKS — FAIL CLOSED
        # ==================================================================

        checks = {

            "model_exists":
                MODEL.exists(),

            "onnx_signature_detected":
                len(inputs) > 0,

            "onnx_state_contract":
                state_contract,

            "real_speech_fixture_present":
                WAV.exists(),

            "real_speech_fixture_readable":
                speech_meta["frames"] > 0,

            "real_speech_fixture_16bit":
                speech_meta[
                    "sample_width"
                ] == 2,

            "real_speech_fixture_mono":
                speech_meta[
                    "channels"
                ] == 1,

            "ram_resampling_applied":
                (
                    speech_meta[
                        "source_sample_rate"
                    ]
                    != 16000
                    and
                    speech_meta[
                        "target_sample_rate"
                    ]
                    == 16000
                ),

            "resampling_policy_in_memory":
                speech_meta[
                    "resampling_policy"
                ]
                == "IN_MEMORY_ONLY",

            "source_audio_untouched":
                source_audio_untouched,

            "silence_contract":
                silence_contract,

            "async_pipeline":
                async_pipeline_valid,

            "bounded_queue":
                queue_maxsize > 0,

            "queue_overflow_isolated":
                overflow_valid,

            "cancellation_handled":
                cancellation_valid,

            "inference_p50_sla":
                p50 < 15.0,

            "inference_p95_sla":
                p95 < 15.0,

            "inference_p99_sla":
                p99 < 15.0,

            "inference_max_sla":
                max_ms < 15.0,

            "real_speech_detected":
                real_speech_started,

            "real_speech_ended":
                real_speech_ended,
        }

        failed_checks = [
            key
            for key, value
            in checks.items()
            if not value
        ]

        report["checks"] = checks

        report["evidence"][
            "failed_checks"
        ] = failed_checks

        report["evidence"][
            "source_audio_sha256_final"
        ] = source_sha_after

        report["evidence"][
            "source_audio_untouched"
        ] = source_audio_untouched

        report["metrics"] = {

            "silence_probability":
                round(
                    silence_probability,
                    8,
                ),

            "vad_inference_p50_ms":
                round(p50, 4),

            "vad_inference_p95_ms":
                round(p95, 4),

            "vad_inference_p99_ms":
                round(p99, 4),

            "vad_inference_max_ms":
                round(max_ms, 4),

            "async_event_count":
                len(async_events),

            "async_events":
                async_events,

            "queue_maxsize":
                queue_maxsize,

            "queue_size_after_overflow":
                queue_size,

            "overflow_count":
                overflow_count,

            "speech_probability_max":
                (
                    round(
                        speech_probability_max,
                        8,
                    )
                    if speech_probability_max
                    is not None
                    else None
                ),

            "speech_started_count":
                speech_events.count(
                    "SPEECH_STARTED"
                ),

            "speech_ended_count":
                speech_events.count(
                    "SPEECH_ENDED"
                ),

            "speech_events":
                speech_events,

            "total_runtime_ms":
                round(
                    (
                        time.perf_counter()
                        - started
                    )
                    * 1000.0,
                    3,
                ),
        }

        # ==================================================================
        # FINAL DECISION
        # ==================================================================

        if failed_checks:

            report["status"] = "FAILED"
            report["score"] = 0

            report["errors"].append({

                "type":
                    "CertificationFailure",

                "message":
                    "10/10 REFUSED — "
                    "CRITICAL EVIDENCE MISSING OR INVALID",

                "failed_checks":
                    failed_checks,
            })

        else:

            report["status"] = "CERTIFIED"
            report["score"] = 10

    except BaseException as exc:

        report["status"] = "FAILED"
        report["score"] = 0

        report["errors"].append({

            "type":
                type(exc).__name__,

            "message":
                str(exc),

            "traceback":
                traceback.format_exc(),
        })

    finally:

        for recorder in recorders:

            try:
                recorder.stop()
            except BaseException:
                pass

        REPORT.parent.mkdir(
            parents=True,
            exist_ok=True,
        )

        REPORT.write_text(
            json.dumps(
                report,
                indent=2,
                ensure_ascii=False,
            ),
            encoding="utf-8",
        )

        print()
        print("=" * 80)
        print(
            " E-ZZIO V7 — PHASE 4.1-H RESULT"
        )
        print("=" * 80)
        print(
            f"STATUS : {report['status']}"
        )
        print(
            f"SCORE  : {report['score']}/10"
        )
        print(
            f"REPORT : {REPORT}"
        )
        print("=" * 80)

        if report["errors"]:

            print()
            print("ERROR:")
            print(
                report["errors"][-1][
                    "message"
                ]
            )


# ============================================================================
