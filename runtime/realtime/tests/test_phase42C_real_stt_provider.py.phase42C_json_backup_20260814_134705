import asyncio
import json
import sys
import time
import numpy as np
from pathlib import Path

ROOT = Path(r"G:\AI\E-zzio")

if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

import bootstrap

from runtime.realtime.stt.whisper_provider import (
    WhisperSttProvider
)


REPORT = (
    ROOT
    / "runtime"
    / "realtime"
    / "tests"
    / "reports"
    / "phase42C_report.json"
)


def utc_now():
    return time.strftime(
        "%Y-%m-%dT%H:%M:%SZ",
        time.gmtime()
    )


async def run_audit():

    started = time.perf_counter()

    checks = {}
    evidence = {}
    errors = []

    # ---------------------------------------------------------------
    # 1. PROVIDER CONTRACT
    # ---------------------------------------------------------------

    provider = WhisperSttProvider(
        model_size="tiny",
        language="fr",
        device="cpu",
        compute_type="int8",
        beam_size=1,
    )

    checks["provider_instantiated"] = (
        provider is not None
    )

    checks["provider_is_real_whisper_provider"] = (
        type(provider).__name__
        == "WhisperSttProvider"
    )

    checks["no_mock_fallback"] = (
        "MockSttProvider"
        not in type(provider).__name__
    )

    # ---------------------------------------------------------------
    # 2. AUDIO CONTRACT
    # ---------------------------------------------------------------

    sample_rate = 16000

    duration_s = 1.0

    samples = int(
        sample_rate * duration_s
    )

    # Deterministic low-level audio fixture.
    # This is deliberately NOT presented as a speech truth test.
    t = np.arange(
        samples,
        dtype=np.float32
    ) / sample_rate

    audio = (
        0.02
        * np.sin(
            2.0
            * np.pi
            * 440.0
            * t
        )
    ).astype(np.float32)

    checks["audio_is_float32"] = (
        audio.dtype == np.float32
    )

    checks["audio_is_16khz"] = (
        sample_rate == 16000
    )

    checks["audio_is_finite"] = (
        np.isfinite(audio).all()
    )

    # ---------------------------------------------------------------
    # 3. REAL BACKEND EXECUTION
    # ---------------------------------------------------------------

    try:

        result = await provider.transcribe(
            audio,
            sample_rate
        )

        checks["real_backend_executed"] = (
            result is not None
        )

        checks["result_matches_stt_contract"] = (
            hasattr(result, "text")
            and hasattr(result, "confidence")
            and hasattr(result, "duration_s")
            and hasattr(result, "latencies")
            and hasattr(result, "provenance")
        )

        checks["result_duration_valid"] = (
            result.duration_s > 0
        )

        checks["latency_recorded"] = (
            "stt_exec_ms"
            in result.latencies
            and
            result.latencies["stt_exec_ms"] >= 0
        )

        checks["real_provider_provenance"] = (
            result.provenance.get("provider")
            == "WhisperSttProvider"
            and
            result.provenance.get("backend")
            == "faster-whisper"
        )

        evidence["transcription"] = {
            "text": result.text,
            "confidence": result.confidence,
            "duration_s": result.duration_s,
            "latencies": result.latencies,
            "provenance": result.provenance,
        }

    except Exception as exc:

        checks["real_backend_executed"] = False
        checks["result_matches_stt_contract"] = False
        checks["result_duration_valid"] = False
        checks["latency_recorded"] = False
        checks["real_provider_provenance"] = False

        errors.append({
            "type": type(exc).__name__,
            "message": str(exc),
        })

    # ---------------------------------------------------------------
    # 4. FAIL-CLOSED VALIDATION
    # ---------------------------------------------------------------

    try:

        await provider.transcribe(
            np.array([], dtype=np.float32),
            16000
        )

        checks["empty_audio_rejected"] = False

    except ValueError:

        checks["empty_audio_rejected"] = True

    except Exception:

        checks["empty_audio_rejected"] = False

    try:

        await provider.transcribe(
            audio,
            8000
        )

        checks["wrong_sample_rate_rejected"] = False

    except ValueError:

        checks["wrong_sample_rate_rejected"] = True

    except Exception:

        checks["wrong_sample_rate_rejected"] = False

    # ---------------------------------------------------------------
    # FINAL
    # ---------------------------------------------------------------

    failed = [
        key
        for key, value in checks.items()
        if not value
    ]

    certified = (
        len(failed) == 0
    )

    elapsed_ms = (
        time.perf_counter() - started
    ) * 1000.0

    evidence["failed_checks"] = failed

    report = {

        "component":
            "Real Local STT Provider",

        "phase":
            "4.2-C",

        "status":
            "CERTIFIED"
            if certified
            else "FAILED",

        "score":
            10
            if certified
            else 0,

        "timestamp_utc":
            utc_now(),

        "checks":
            checks,

        "metrics": {
            "total_runtime_ms":
                elapsed_ms,

            "provider_call_count":
                provider.call_count
        },

        "evidence":
            evidence,

        "errors":
            errors
    }

    REPORT.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    REPORT.write_text(
        json.dumps(
            report,
            indent=2,
            ensure_ascii=False
        ),
        encoding="utf-8"
    )

    print(
        json.dumps(
            report,
            indent=2,
            ensure_ascii=False
        )
    )

    return (
        0
        if certified
        else 1
    )


if __name__ == "__main__":
    sys.exit(
        asyncio.run(
            run_audit()
        )
    )