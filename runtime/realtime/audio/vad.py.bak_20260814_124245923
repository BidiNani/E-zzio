import numpy as np
import time
import onnxruntime as ort

class SileroVAD:
    """Moteur VAD Silero v5 — Signature stricte ONNX CPU."""
    def __init__(self, model_path: str, threshold: float = 0.5):
        self.threshold = threshold
        self.sample_rate = np.int64(16000)
        
        opt = ort.SessionOptions()
        opt.inter_op_num_threads = 1
        opt.intra_op_num_threads = 1
        
        self.session = ort.InferenceSession(
            model_path, 
            sess_options=opt, 
            providers=['CPUExecutionProvider']
        )
        self.reset_state()

    def reset_state(self):
        self.state = np.zeros((2, 1, 128), dtype=np.float32)

    def is_speech(self, audio_chunk: np.ndarray) -> tuple[bool, float]:
        tensor = np.expand_dims(audio_chunk.flatten(), axis=0).astype(np.float32)
        
        ort_inputs = {
            'input': tensor,
            'state': self.state,
            'sr': self.sample_rate
        }
        
        ort_outs = self.session.run(None, ort_inputs)
        prob = float(ort_outs[0][0, 0])
        self.state = ort_outs[1]
        
        return (prob > self.threshold), prob

class VADController:
    """Contrôleur temporel avec Hangover (debounce) — Fail-Closed."""
    def __init__(self, model_path: str, threshold: float = 0.5, hangover_frames: int = 8):
        self.hangover_frames = hangover_frames
        self._cooldown = 0
        self.is_speaking = False
        self.engine = SileroVAD(model_path=model_path, threshold=threshold)

    def reset(self):
        self.engine.reset_state()
        self._cooldown = 0
        self.is_speaking = False

    def process_chunk(self, audio_chunk: np.ndarray, t2_queue_timestamp: float) -> dict:
        t3_start = time.perf_counter()
        speech_detected, prob = self.engine.is_speech(audio_chunk)
        t4_end = time.perf_counter()

        event = "SILENCE"
        if speech_detected:
            self._cooldown = self.hangover_frames
            if not self.is_speaking:
                self.is_speaking = True
                event = "SPEECH_STARTED"
            else:
                event = "SPEECH_ONGOING"
        else:
            if self._cooldown > 0:
                self._cooldown -= 1
                event = "SPEECH_ONGOING"
            elif self.is_speaking:
                self.is_speaking = False
                event = "SPEECH_ENDED"

        return {
            "event": event,
            "probability": prob,
            "metrics": {
                "t3_silero_start": t3_start,
                "t4_vad_decision": t4_end,
                "vad_inference_ms": (t4_end - t3_start) * 1000,
                "queue_to_vad_ms": (t3_start - t2_queue_timestamp) * 1000
            }
        }
