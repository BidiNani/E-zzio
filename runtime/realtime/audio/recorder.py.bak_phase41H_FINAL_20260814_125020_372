import asyncio
import time

import numpy as np

from .vad import VADController


class AsyncAudioRecorder:

    def __init__(
        self,
        vad_model_path: str,
        sample_rate: int = 16000,
        chunk_samples: int = 512,
        virtual_mode: bool = False,
    ):

        self.sample_rate = int(sample_rate)
        self.chunk_samples = int(chunk_samples)
        self.virtual_mode = bool(virtual_mode)

        self.queue = asyncio.Queue(maxsize=8)

        self._stream = None
        self._is_recording = False

        self.vad = VADController(
            model_path=vad_model_path
        )

        self.loop = None
        self.overflow_count = 0

    def feed_virtual_chunk(
        self,
        chunk: np.ndarray,
        timestamp: float,
    ):

        item = (
            np.asarray(
                chunk,
                dtype=np.float32,
            ),
            float(timestamp),
        )

        try:

            self.queue.put_nowait(item)

        except asyncio.QueueFull:

            self.overflow_count += 1

            try:
                self.queue.get_nowait()
            except asyncio.QueueEmpty:
                pass

            self.queue.put_nowait(item)

    def _callback(
        self,
        indata,
        frames,
        ctime,
        status,
    ):

        timestamp = time.perf_counter()

        chunk = np.asarray(
            indata.copy(),
            dtype=np.float32,
        )

        def enqueue():

            self.feed_virtual_chunk(
                chunk,
                timestamp,
            )

        if self.loop and self.loop.is_running():

            self.loop.call_soon_threadsafe(
                enqueue
            )

    def _start_portaudio(self):

        if self.virtual_mode:
            return

        import sounddevice as sd

        self._stream = sd.InputStream(
            samplerate=self.sample_rate,
            channels=1,
            dtype="float32",
            blocksize=self.chunk_samples,
            callback=self._callback,
        )

        self._stream.start()

    async def listen_stream(self):

        if self._is_recording:
            return

        self.loop = asyncio.get_running_loop()
        self._is_recording = True

        self.vad.reset()

        self._start_portaudio()

        try:

            while self._is_recording:

                try:

                    chunk, t1 = await asyncio.wait_for(
                        self.queue.get(),
                        timeout=1.0,
                    )

                except asyncio.TimeoutError:

                    continue

                except asyncio.CancelledError:

                    break

                t2 = time.perf_counter()

                result = self.vad.process_chunk(
                    chunk,
                    t2,
                )

                result["metrics"]["t1_callback"] = t1
                result["metrics"]["t2_dequeue"] = t2

                yield result

        finally:

            self.stop()

    def stop(self):

        self._is_recording = False

        if self._stream:

            try:
                self._stream.stop()
            except Exception:
                pass

            try:
                self._stream.close()
            except Exception:
                pass

            self._stream = None

        while True:

            try:
                self.queue.get_nowait()
            except asyncio.QueueEmpty:
                break
