import time
from typing import Dict, Tuple

import numpy as np
import onnxruntime as ort


class SileroContractError(RuntimeError):
    """Erreur de contrat ONNX Silero."""


class SileroVAD:
    """
    Silero VAD ONNX CPU — implémentation stateful durcie.

    Principes :
      - contrat ONNX inspecté au démarrage
      - SR transmis comme ndarray int64
      - state conservé entre les appels
      - contexte audio conservé entre les appels
      - fail-closed
    """

    SAMPLE_RATE = 16000
    CONTEXT_SAMPLES = 64
    STATE_SHAPE = (2, 1, 128)

    def __init__(
        self,
        model_path: str,
        threshold: float = 0.5,
    ):
        self.model_path = model_path
        self.threshold = float(threshold)

        options = ort.SessionOptions()
        options.inter_op_num_threads = 1
        options.intra_op_num_threads = 1
        options.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
        options.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL

        self.session = ort.InferenceSession(
            model_path,
            sess_options=options,
            providers=["CPUExecutionProvider"],
        )

        self.inputs = {
            item.name: item
            for item in self.session.get_inputs()
        }

        self.outputs = {
            item.name: item
            for item in self.session.get_outputs()
        }

        self._validate_contract()
        self.reset_state()

    def _validate_contract(self) -> None:
        required = {"input", "state", "sr"}

        missing = required.difference(self.inputs.keys())

        if missing:
            raise SileroContractError(
                f"Inputs ONNX manquants: {sorted(missing)}. "
                f"Inputs disponibles: {sorted(self.inputs.keys())}"
            )

        state_type = self.inputs["state"].type
        sr_type = self.inputs["sr"].type
        input_type = self.inputs["input"].type

        if "float" not in input_type:
            raise SileroContractError(
                f"Type input inattendu: {input_type}"
            )

        if state_type not in ("tensor(float)", "tensor(float16)"):
            raise SileroContractError(
                f"Type state inattendu: {state_type}"
            )

        if sr_type != "tensor(int64)":
            raise SileroContractError(
                f"Type sr inattendu: {sr_type}"
            )

        if not self.outputs:
            raise SileroContractError(
                "Le modèle ONNX ne possède aucune sortie."
            )

    def contract(self) -> Dict:
        return {
            "model_path": self.model_path,
            "providers": self.session.get_providers(),
            "inputs": {
                name: {
                    "name": item.name,
                    "type": item.type,
                    "shape": [
                        str(x) for x in item.shape
                    ],
                }
                for name, item in self.inputs.items()
            },
            "outputs": {
                name: {
                    "name": item.name,
                    "type": item.type,
                    "shape": [
                        str(x) for x in item.shape
                    ],
                }
                for name, item in self.outputs.items()
            },
            "sample_rate": self.SAMPLE_RATE,
            "context_samples": self.CONTEXT_SAMPLES,
            "state_shape": list(self.STATE_SHAPE),
        }

    def reset_state(self) -> None:
        self.state = np.zeros(
            self.STATE_SHAPE,
            dtype=np.float32,
        )

        self.context = np.zeros(
            self.CONTEXT_SAMPLES,
            dtype=np.float32,
        )

    @staticmethod
    def _normalize_audio(audio_chunk: np.ndarray) -> np.ndarray:
        audio = np.asarray(
            audio_chunk,
            dtype=np.float32,
        ).reshape(-1)

        if audio.size == 0:
            raise ValueError("Chunk audio vide.")

        if not np.isfinite(audio).all():
            raise ValueError("Chunk audio contient NaN/Inf.")

        return np.ascontiguousarray(audio)

    def is_speech(
        self,
        audio_chunk: np.ndarray,
    ) -> Tuple[bool, float]:
        audio = self._normalize_audio(audio_chunk)

        # Silero attend le contexte précédent + le chunk courant.
        model_input = np.concatenate(
            (
                self.context,
                audio,
            )
        ).astype(
            np.float32,
            copy=False,
        )

        model_input = np.ascontiguousarray(
            model_input.reshape(1, -1)
        )

        # IMPORTANT :
        # ONNX Runtime attend ici un vrai ndarray int64,
        # pas un scalaire numpy.int64.
        sr = np.asarray(
            self.SAMPLE_RATE,
            dtype=np.int64,
        )

        ort_inputs = {
            "input": model_input,
            "state": np.ascontiguousarray(
                self.state,
                dtype=np.float32,
            ),
            "sr": sr,
        }

        outputs = self.session.run(
            None,
            ort_inputs,
        )

        if len(outputs) < 2:
            raise SileroContractError(
                f"Nombre de sorties ONNX inattendu: {len(outputs)}"
            )

        probability_raw = np.asarray(
            outputs[0]
        ).reshape(-1)

        if probability_raw.size == 0:
            raise SileroContractError(
                "Sortie probability vide."
            )

        probability = float(
            probability_raw[0]
        )

        next_state = np.asarray(
            outputs[1],
            dtype=np.float32,
        )

        if next_state.shape != self.STATE_SHAPE:
            raise SileroContractError(
                "Shape state retournée inattendue: "
                f"{next_state.shape}, attendu {self.STATE_SHAPE}"
            )

        self.state = np.ascontiguousarray(
            next_state
        )

        # Le dernier bloc audio devient le contexte suivant.
        self.context = np.ascontiguousarray(
            audio[-self.CONTEXT_SAMPLES:],
            dtype=np.float32,
        )

        return (
            probability >= self.threshold,
            probability,
        )


class VADController:
    """
    Contrôleur temporel :
      - Silero stateful
      - hangover
      - SPEECH_STARTED
      - SPEECH_ONGOING
      - SPEECH_ENDED
    """

    def __init__(
        self,
        model_path: str,
        threshold: float = 0.5,
        hangover_frames: int = 8,
    ):
        if hangover_frames < 0:
            raise ValueError(
                "hangover_frames doit être >= 0"
            )

        self.hangover_frames = int(
            hangover_frames
        )

        self._cooldown = 0
        self.is_speaking = False

        self.engine = SileroVAD(
            model_path=model_path,
            threshold=threshold,
        )

    def reset(self) -> None:
        self.engine.reset_state()
        self._cooldown = 0
        self.is_speaking = False

    def contract(self) -> Dict:
        return self.engine.contract()

    def process_chunk(
        self,
        audio_chunk: np.ndarray,
        t2_queue_timestamp: float,
    ) -> dict:
        t3_start = time.perf_counter()

        speech_detected, probability = (
            self.engine.is_speech(audio_chunk)
        )

        t4_end = time.perf_counter()

        if speech_detected:
            self._cooldown = self.hangover_frames

            if not self.is_speaking:
                self.is_speaking = True
                event = "SPEECH_STARTED"
            else:
                event = "SPEECH_ONGOING"

        else:
            if self._cooldown > 0:
                self._cooldown -= 1
                event = "SPEECH_ONGOING"

            elif self.is_speaking:
                self.is_speaking = False
                event = "SPEECH_ENDED"

            else:
                event = "SILENCE"

        return {
            "event": event,
            "probability": probability,
            "engine": "SILERO_V5_ONNX_CPU",
            "metrics": {
                "t2_queue_dequeue": t2_queue_timestamp,
                "t3_vad_start": t3_start,
                "t4_vad_decision": t4_end,
                "vad_inference_ms": (
                    t4_end - t3_start
                ) * 1000.0,
            },
        }