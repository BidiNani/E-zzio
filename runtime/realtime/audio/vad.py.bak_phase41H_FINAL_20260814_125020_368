import time
from typing import Dict, Tuple

import numpy as np
import onnxruntime as ort


class SileroVAD:
    """
    E-ZZIO V7 — ONNX VAD hardened.

    IMPORTANT:
    La signature du modèle est inspectée dynamiquement.
    Aucun type ONNX n'est supposé arbitrairement.
    """

    def __init__(
        self,
        model_path: str,
        threshold: float = 0.5,
        sample_rate: int = 16000,
    ):
        self.threshold = float(threshold)
        self.sample_rate = int(sample_rate)

        options = ort.SessionOptions()
        options.inter_op_num_threads = 1
        options.intra_op_num_threads = 1
        options.graph_optimization_level = (
            ort.GraphOptimizationLevel.ORT_ENABLE_ALL
        )

        self.session = ort.InferenceSession(
            model_path,
            sess_options=options,
            providers=["CPUExecutionProvider"],
        )

        self.inputs = self.session.get_inputs()
        self.outputs = self.session.get_outputs()

        self.input_map = {x.name: x for x in self.inputs}
        self.output_map = {x.name: x for x in self.outputs}

        self.state_name = None
        self.sr_name = None
        self.audio_name = None

        for item in self.inputs:
            name = item.name.lower()

            if name == "state" or "state" in name:
                self.state_name = item.name

            elif name in ("sr", "sample_rate", "sampling_rate"):
                self.sr_name = item.name

            elif name in ("input", "audio", "x"):
                self.audio_name = item.name

        if self.audio_name is None:
            # Fallback : premier input float
            for item in self.inputs:
                if "float" in str(item.type).lower():
                    self.audio_name = item.name
                    break

        if self.audio_name is None:
            raise RuntimeError(
                "Impossible d'identifier l'entrée audio ONNX."
            )

        self.state = None
        self.reset_state()

    def _make_state(self):
        """
        Détermine automatiquement la forme du state.
        """

        if self.state_name is None:
            return None

        meta = self.input_map[self.state_name]
        shape = meta.shape

        resolved = []

        for dimension in shape:
            if isinstance(dimension, int):
                resolved.append(dimension)
            else:
                # Silero classique
                if len(resolved) == 0:
                    resolved.append(2)
                elif len(resolved) == 1:
                    resolved.append(1)
                else:
                    resolved.append(128)

        if any(v is None for v in resolved):
            raise RuntimeError(
                f"Shape state ONNX non résolue : {shape}"
            )

        return np.zeros(tuple(resolved), dtype=np.float32)

    def reset_state(self):
        self.state = self._make_state()

    def _prepare_sample_rate(self):
        """
        Construit sr selon le type ONNX déclaré.
        """

        if self.sr_name is None:
            return None

        meta = self.input_map[self.sr_name]
        onnx_type = str(meta.type).lower()

        if "int64" in onnx_type:
            return np.array([self.sample_rate], dtype=np.int64)

        if "int32" in onnx_type:
            return np.array([self.sample_rate], dtype=np.int32)

        if "float" in onnx_type:
            return np.array([float(self.sample_rate)], dtype=np.float32)

        return np.array([self.sample_rate], dtype=np.int64)

    def is_speech(
        self,
        audio_chunk: np.ndarray,
    ) -> Tuple[bool, float]:

        audio = np.asarray(
            audio_chunk,
            dtype=np.float32,
        ).reshape(-1)

        if audio.size == 0:
            return False, 0.0

        # ONNX attend généralement [1, samples]
        tensor = audio.reshape(1, -1)

        ort_inputs = {
            self.audio_name: tensor
        }

        if self.state_name is not None:
            ort_inputs[self.state_name] = self.state

        sr = self._prepare_sample_rate()

        if sr is not None:
            ort_inputs[self.sr_name] = sr

        ort_outputs = self.session.run(
            None,
            ort_inputs,
        )

        if not ort_outputs:
            raise RuntimeError(
                "Le modèle ONNX n'a produit aucune sortie."
            )

        # Première sortie = probabilité VAD dans les modèles Silero classiques
        probability = float(
            np.asarray(ort_outputs[0]).reshape(-1)[0]
        )

        # Deuxième sortie = état suivant si présent
        if self.state_name is not None and len(ort_outputs) >= 2:
            self.state = np.asarray(
                ort_outputs[1],
                dtype=np.float32,
            )

        return (
            probability >= self.threshold,
            probability,
        )


class VADController:
    """
    Contrôle temporel :

        SPEECH_STARTED
        SPEECH_ONGOING
        SPEECH_ENDED

    avec hangover pour éviter les coupures prématurées.
    """

    def __init__(
        self,
        model_path: str,
        threshold: float = 0.5,
        hangover_frames: int = 8,
    ):
        self.hangover_frames = int(hangover_frames)

        if self.hangover_frames < 0:
            raise ValueError("hangover_frames doit être >= 0")

        self._cooldown = 0
        self.is_speaking = False

        self.engine = SileroVAD(
            model_path=model_path,
            threshold=threshold,
        )

    def reset(self):
        self.engine.reset_state()
        self._cooldown = 0
        self.is_speaking = False

    def process_chunk(
        self,
        audio_chunk: np.ndarray,
        t2_queue_timestamp: float,
    ) -> Dict:

        t3_start = time.perf_counter()

        speech_detected, probability = self.engine.is_speech(
            audio_chunk
        )

        t4_end = time.perf_counter()

        if speech_detected:

            self._cooldown = self.hangover_frames

            if not self.is_speaking:
                self.is_speaking = True
                event = "SPEECH_STARTED"
            else:
                event = "SPEECH_ONGOING"

        else:

            if self._cooldown > 0:
                self._cooldown -= 1
                event = (
                    "SPEECH_ONGOING"
                    if self.is_speaking
                    else "SILENCE"
                )

            elif self.is_speaking:
                self.is_speaking = False
                event = "SPEECH_ENDED"

            else:
                event = "SILENCE"

        return {
            "event": event,
            "probability": probability,
            "engine": "SILERO_ONNX_CPU",
            "metrics": {
                "t2_queue_timestamp": t2_queue_timestamp,
                "t3_vad_start": t3_start,
                "t4_vad_decision": t4_end,
                "vad_inference_ms": (
                    t4_end - t3_start
                ) * 1000.0,
                "queue_to_vad_ms": (
                    t3_start - t2_queue_timestamp
                ) * 1000.0,
            },
        }
