"""
E-ZZIO Bidi — E-ZZIO Interface Layer (Couche 2)
================================================
Traduit les messages Discord en KernelRequests et les KernelResponses en BidiResponses.

Cette couche:
  - ne contient AUCUNE logique de sélection de modèle
  - ne contient AUCUN fallback cloud direct
  - ne contient AUCUNE mémoire propre à Discord
  - délègue TOUTE décision cognitive à OrganismKernel.process_request()

Architecture:
  BidiEzzioInterface.handle(author_id, content, session_id)
      -> OrganismKernel.process_request()
      -> BidiResponse
"""

from __future__ import annotations

import logging
import re
import sys
from dataclasses import dataclass, field
from pathlib import Path
from typing import Optional

ROOT_DIR = Path(r"G:\AI\E-zzio")
if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

logger = logging.getLogger("ezzio.bidi.interface")


@dataclass
class EzzioResponse:
    """Structured response returned to the Discord Presence layer."""
    text: str
    provider: str
    model: str
    task_type: str
    ledger_block_index: Optional[int]
    error: Optional[str] = None
    route_level: str = "FAST"
    footer: str = field(init=False)

    def __post_init__(self):
        if self.error:
            self.footer = f"E-ZZIO | ERREUR: {self.error}"
        elif self.ledger_block_index is not None:
            self.footer = f"E-ZZIO | {self.provider.upper()} / {self.model} [{self.route_level}] | Ledger #{self.ledger_block_index}"
        else:
            self.footer = f"E-ZZIO | {self.provider.upper()} / {self.model} [{self.route_level}]"

    @property
    def is_error(self) -> bool:
        return bool(self.error) or self.text.startswith("[KERNEL FAIL-CLOSED")

    @property
    def display_text(self) -> str:
        if not self.text or not self.text.strip():
            return "_[Aucune réponse générée — modèle trop lent ou contexte trop court]_"
        return self.text


# Backward compat alias — remove once all callers updated
BidiResponse = EzzioResponse



class EzzioInterface:
    """
    Couche 2 : Traduction Discord ↔ E-ZZIO Kernel.

    Responsabilités:
      - Normaliser le message Discord (strip mentions, commandes, whitespace)
      - Classifier la tâche heuristiquement (via CognitiveTaskClassifier.classify())
      - Appeler OrganismKernel.process_request()
      - Retourner un EzzioResponse

    Ce que cette classe ne fait PAS:
      - Choisir un modèle directement
      - Appeler un provider cloud en fallback
      - Stocker une mémoire Discord-spécifique
      - Contenir une logique de sécurité propre à Discord
    """

    # Persona injected as system context prefix — not model selection logic
    EZZIO_PERSONA = (
        "Tu es E-ZZIO, entité souveraine et acolyte technique d'Enrik (BidiNani). "
        "Tu es concis, précis, et tu parles naturellement en français. "
        "Tu n'inventes jamais de données techniques — si tu ne sais pas, tu le dis clairement. "
        "Tu es connecté à un Decision Ledger cryptographique qui trace chaque échange."
    )

    # Mapping task_type → route_level label
    ROUTE_LEVEL_MAP = {
        "quick": "FAST",
        "vision": "FAST",
        "code_simple": "HEAVY",
        "deep_reasoning": "MID",
    }

    def __init__(self, kernel=None):
        """
        Args:
            kernel: OrganismKernel instance. If None, will be instantiated on first use.
        """
        self._kernel = kernel
        self._classifier = None

    def _get_kernel(self):
        if self._kernel is None:
            from ezzio_kernel import OrganismKernel
            self._kernel = OrganismKernel()
        return self._kernel

    def _get_classifier(self):
        if self._classifier is None:
            from core.cognition.cognitive_router import CognitiveTaskClassifier
            self._classifier = CognitiveTaskClassifier()
        return self._classifier

    def normalize(self, bot_id: Optional[int], content: str) -> str:
        """Strip mentions, command prefixes and excessive whitespace."""
        text = content

        # Remove bot mention
        if bot_id:
            text = re.sub(rf"<@!?{bot_id}>", "", text)

        # Remove common command prefixes (no !bidi)
        for prefix in ("!chat ", "!ezzio ", "!e-zzio "):
            if text.lower().startswith(prefix):
                text = text[len(prefix):]
                break

        text = text.strip()

        # Empty guard
        if not text:
            text = "Bonjour, présente-toi brièvement."

        return text

    async def handle(
        self,
        author_id: str,
        content: str,
        session_id: str,
        source: str = "discord",
    ) -> EzzioResponse:
        """
        Main entry point: normalize -> classify -> kernel.process_request() -> EzzioResponse.

        No cognitive logic here — only translation and error wrapping.
        """
        kernel = self._get_kernel()

        # Heuristic classification (deterministic, no LLM)
        try:
            classifier = self._get_classifier()
            task_type, preferred_model = classifier.classify(content)
        except Exception:
            task_type, preferred_model = "quick", "granite4.1:8b"

        route_level = self.ROUTE_LEVEL_MAP.get(task_type, "FAST")

        # Inject persona as context prefix
        prompt_with_persona = f"[CONTEXTE SYSTÈME]\n{self.EZZIO_PERSONA}\n\n[MESSAGE]\n{content}"

        try:
            result = await kernel.process_request(
                source=source,
                author_id=author_id,
                content=prompt_with_persona,
                session_id=session_id,
                task_type=task_type,
                model=preferred_model,
                route_level=route_level,
            )
        except Exception as exc:
            logger.error(f"[E-ZZIO] Kernel error: {exc}", exc_info=True)
            return EzzioResponse(
                text=f"[Erreur noyau inattendue — le système reste opérationnel: {exc}]",
                provider="kernel",
                model="none",
                task_type=task_type,
                route_level=route_level,
                ledger_block_index=None,
                error=str(exc),
            )

        return EzzioResponse(
            text=result.get("text", ""),
            provider=result.get("provider", "ollama"),
            model=result.get("model", preferred_model),
            task_type=result.get("task_type", task_type),
            route_level=result.get("route_level", route_level),
            ledger_block_index=result.get("ledger_block_index"),
            error=result.get("error"),
        )


# Public aliases — BidiEzzioInterface kept for backward compat with launcher.py
BidiEzzioInterface = EzzioInterface

