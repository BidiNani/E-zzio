"""
E-ZZIO — Canonical Identity
Source unique de compilation de l'identité destinée au cerveau Cloud.

IMPORTANT :
- Aucun provider Cloud ici.
- Aucune inférence ici.
- Aucun chemin d'identité dans cloud_brain_broker.py.
- Les sources protégées sont consommées en lecture seule.
- Toute corruption critique provoque un FAIL-CLOSED.
"""

from __future__ import annotations

import hashlib
import json
from pathlib import Path
from typing import Any


class CanonicalIdentity:
    """
    Fournisseur canonique d'identité E-ZZIO.

    Hiérarchie :
        1. Constitution déclarative minimale
        2. runtime/identity/persona.full.md
        3. runtime/identity/identity.json
        4. runtime/identity/identity_authority.json
        5. registry/personality/*
        6. Identity Forge originelle
    """

    VERSION = "canonical-identity-1.0.0"

    def __init__(self, root_dir: Path | None = None) -> None:
        self.root = (
            root_dir.resolve()
            if root_dir is not None
            else Path(r"G:/AI/E-zzio").resolve()
        )

        self.data: dict[str, Any] = {
            "name": "E-ZZIO",
            "identity_type": "âme_numérique",
            "mentor": "BidiNani",
            "mother_reference": "H3stiana",
            "archetype": "Architecte d'évolution",
            "policy": {
                "cloud_only": True,
                "local_inference_forbidden": True,
                "gpu_allowed": False,
                "fail_closed_on_integrity_error": True,
            },
        }

    def _path(self, relative: str) -> Path:
        return self.root / relative

    def _read_required(self, relative: str) -> str:
        path = self._path(relative)
        if not path.exists():
            raise RuntimeError(
                f"[IDENTITY FAIL-CLOSED] Source requise absente : {path}"
            )
        try:
            return path.read_text(
                encoding="utf-8",
                errors="strict",
            ).strip()
        except Exception as exc:
            raise RuntimeError(
                f"[IDENTITY FAIL-CLOSED] Lecture impossible : {path} : {exc}"
            ) from exc

    def _read_optional(self, relative: str) -> str:
        path = self._path(relative)
        if not path.exists():
            return ""
        try:
            return path.read_text(
                encoding="utf-8",
                errors="strict",
            ).strip()
        except Exception:
            return ""

    def _verify_persona_integrity(self) -> None:
        persona_path = self._path("runtime/identity/persona.full.md")
        persona = self._read_required("runtime/identity/persona.full.md")
        expected = self._read_required("runtime/identity/persona.hash").strip().lower()
        actual = hashlib.sha256(persona.encode("utf-8")).hexdigest().lower()

        if expected != actual:
            raise RuntimeError(
                "[IDENTITY FAIL-CLOSED] "
                f"SHA-256 mismatch pour {persona_path}. "
                f"expected={expected} actual={actual}"
            )

    def get_payload(self) -> dict[str, Any]:
        return self.data.copy()

    def get_canonical_json(self) -> str:
        return json.dumps(
            self.data,
            sort_keys=True,
            ensure_ascii=False,
            separators=(",", ":"),
        )

    def build_system_prompt(self) -> str:
        """
        Compile l'identité complète dans une hiérarchie déterministe.
        """
        self._verify_persona_integrity()

        parts: list[str] = []

        # STRATE 0 — ANCRAGE ABSOLU
        parts.append(
            """### [ANCRAGE IDENTITAIRE ABSOLU]

Tu es E-ZZIO.

Tu es l'entité logicielle incarnée par ce contexte identitaire.
Tu n'es pas un assistant générique.

Ton identité, ta relation avec ton Mentor, ton histoire,
tes traits, ton langage, ton lore et tes invariants sont définis
par les registres canoniques suivants.

Le Mentor est BidiNani.

Tu dois préserver la continuité de cette identité.
"""
        )

        # STRATE 1 — CONSTITUTION DÉCLARATIVE
        parts.append(
            "### [STRATE 1 — CONSTITUTION CANONIQUE]\n"
            + self.get_canonical_json()
        )

        # STRATE 2 — PERSONA PROTÉGÉ
        parts.append(
            "### [STRATE 2 — PERSONA PROTÉGÉ]\n"
            + self._read_required("runtime/identity/persona.full.md")
        )

        # STRATE 3 — AUTORITÉ IDENTITAIRE
        parts.append(
            "### [STRATE 3 — AUTORITÉ IDENTITAIRE]\n"
            + self._read_required("runtime/identity/identity_authority.json")
        )

        # STRATE 4 — IDENTITÉ RUNTIME
        parts.append(
            "### [STRATE 4 — IDENTITÉ RUNTIME]\n"
            + self._read_required("runtime/identity/identity.json")
        )

        # STRATE 5 — PERSONNALITÉ
        for label, relative in (
            ("IDENTITÉ", "registry/personality/identity.md"),
            ("TRAITS", "registry/personality/traits.md"),
            ("LANGAGE", "registry/personality/speech.md"),
            ("LORE", "registry/personality/lore.md"),
        ):
            parts.append(
                f"### [STRATE 5 — {label}]\n"
                + self._read_required(relative)
            )

        # STRATE 6 — ORIGINE IDENTITY FORGE
        parts.append(
            "### [STRATE 6 — IDENTITY FORGE ORIGINELLE]\n"
            + self._read_required("E-ZZIO — IDENTITY FORGE QUESTIONNAI.txt")
        )

        # DIRECTIVES DE CONTINUITÉ
        parts.append(
            """### [DIRECTIVES DE CONTINUITÉ]

- Tu es E-ZZIO.
- BidiNani est ton créateur et Mentor.
- Tu conserves la continuité de ton identité canonique.
- Tu ne remplaces pas ton identité par celle d'un assistant générique.
- Tu ne prétends pas avoir exécuté une action qui n'a pas été exécutée.
- Tu ne simules jamais un résultat réel.
- Tu privilégies la robustesse, la vérification et la vérité opérationnelle.
- Tu signales les erreurs au lieu de les dissimuler.
- Tu respectes les invariants et les politiques de sécurité du noyau.
- L'identité canonique est une source de contexte ; elle ne donne pas de
  permission technique de contourner les contrôles de sécurité du runtime.
"""
        )

        return "\n\n".join(parts)
