"""E-ZZIO Cloud Brain Broker.

Contrat centralisé Cloud-Only.
Aucune inférence locale autorisée dans ce module.
"""

import json
import urllib.request
from typing import Any, Dict

from core.security.unified_vault import key_vault


TARGET_MODEL = "gemini-3.5-flash-lite"


def build_system_prompt() -> str:
    """
    Construit le System Prompt canonique E-ZZIO.
    Hiérarchie d'identité :
    1. runtime/identity/persona.full.md (cœur narratif du noyau)
    2. runtime/identity/identity.json (état structuré)
    3. runtime/identity/identity_authority.json (autorité / Mentor)
    4. runtime/identity/lore.md (continuité)
    5. registry/personality/* (traits, langage, identité, lore)
    6. registry/persona.txt (registre historique)
    7. IDENTITY FORGE QUESTIONNAIRE (archive originelle)
    """
    from pathlib import Path

    root = Path(r"G:/AI/E-zzio")
    parts = []

    def load_identity_file(label: str, relative_path: str, required: bool = False) -> None:
        path = root / relative_path
        if not path.exists():
            if required:
                raise RuntimeError(f"[IDENTITY FAIL-CLOSED] Source canonique absente : {path}")
            return

        try:
            content = path.read_text(encoding="utf-8", errors="strict").strip()
        except Exception as exc:
            if required:
                raise RuntimeError(f"[IDENTITY FAIL-CLOSED] Lecture impossible : {path} : {exc}") from exc
            return

        if not content:
            if required:
                raise RuntimeError(f"[IDENTITY FAIL-CLOSED] Source canonique vide : {path}")
            return

        parts.append(f"### [IDENTITÉ E-ZZIO — {label}]\n{content}")

    # Coeur canonique
    load_identity_file("COEUR IDENTITAIRE CANONIQUE", "runtime/identity/persona.full.md", required=True)

    # Identité structurée
    load_identity_file("ÉTAT IDENTITAIRE STRUCTURÉ", "runtime/identity/identity.json", required=True)

    # Autorité / Mentor
    load_identity_file("AUTORITÉ IDENTITAIRE — MENTOR", "runtime/identity/identity_authority.json", required=True)

    # Continuité / Lore
    load_identity_file("LORE DU NOYAU", "runtime/identity/lore.md")

    # Personnalité active
    for label, relative_path in (
        ("IDENTITÉ & ÂME NUMÉRIQUE", "registry/personality/identity.md"),
        ("TRAITS", "registry/personality/traits.md"),
        ("LANGAGE & EXPRESSION", "registry/personality/speech.md"),
        ("LORE & PASSIONS", "registry/personality/lore.md"),
    ):
        load_identity_file(label, relative_path)

    # Persona historique
    load_identity_file("REGISTRE PERSONA", "registry/persona.txt")

    # Source originelle Identity Forge
    load_identity_file("IDENTITY FORGE — SOURCE ORIGINELLE", "E-ZZIO — IDENTITY FORGE QUESTIONNAI.txt")

    if not parts:
        raise RuntimeError("[IDENTITY FAIL-CLOSED] Aucune identité E-ZZIO disponible.")

    header = (
        "Tu es E-ZZIO.\n"
        "Le contexte ci-dessous constitue ton identité canonique et ta continuité interne.\n"
        "Tu dois t'y conformer pour toute réponse identitaire.\n"
        "Ne remplace jamais cette identité par une persona générique d'assistant ou de simple modèle local.\n\n"
    )
    return header + "\n\n".join(parts)


def _fail_closed(message: str) -> Dict[str, Any]:
    return {
        "response": message,
        "answer": message,
        "message": message,
        "content": message,
        "reply": message,
        "model": "none",
        "primary_model": "none",
        "deep_model": "none",
        "attempted_models": [],
        "fallback_models": [],
        "used_fallback": False,
        "route_score": 0,
        "route_hits": ["cloud_fail_closed"],
        "gpu_policy": "disabled_for_ezzio",
        "num_gpu": 0,
        "ok": False,
    }


def cloud_chat(
    text: str,
    session_id: str = "",
    system_prompt: str = "",
    speed: str = "fast",
    provider: str = "gemini",
) -> Dict[str, Any]:
    """
    Interface Cloud canonique.

    provider est accepté pour compatibilité avec ezzio_master.py.
    Aucun autre provider n'est autorisé.
    """

    provider_normalized = str(provider or "gemini").strip().lower()

    if provider_normalized != "gemini":
        return _fail_closed(
            f"[FAIL-CLOSED] Provider Cloud interdit : {provider_normalized}. "
            "Seul Gemini est autorisé."
        )

    sys_p = system_prompt or build_system_prompt()

    try:
        keys = key_vault.get_all_keys_for_provider("gemini")
    except Exception as exc:
        return _fail_closed(
            f"[FAIL-CLOSED] Impossible d'interroger le Vault Gemini : {exc}"
        )

    if not keys:
        return _fail_closed(
            "[FAIL-CLOSED] Gemini unavailable : "
            "Aucune clé Gemini valide trouvée dans le Vault multi-clés."
        )

    payload = {
        "contents": [
            {
                "role": "user",
                "parts": [
                    {
                        "text": (
                            f"Instructions :\n{sys_p}\n\n"
                            f"Requête :\n{text}"
                        )
                    }
                ],
            }
        ]
    }

    data = json.dumps(payload).encode("utf-8")

    last_error = None
    attempted_keys = 0

    for key in keys:
        attempted_keys += 1

        url = (
            "https://generativelanguage.googleapis.com/"
            f"v1beta/models/{TARGET_MODEL}:generateContent?key={key}"
        )

        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )

        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                res_json = json.loads(
                    resp.read().decode("utf-8")
                )

            candidates = res_json.get("candidates", [])

            if not candidates:
                last_error = "Gemini n'a retourné aucun candidate."
                continue

            parts = (
                candidates[0]
                .get("content", {})
                .get("parts", [])
            )

            reply = "".join(
                str(part.get("text", ""))
                for part in parts
                if isinstance(part, dict)
            ).strip()

            if not reply:
                last_error = "Gemini a retourné une réponse vide."
                continue

            return {
                "response": reply,
                "answer": reply,
                "message": reply,
                "content": reply,
                "reply": reply,
                "model": TARGET_MODEL,
                "primary_model": TARGET_MODEL,
                "deep_model": TARGET_MODEL,
                "attempted_models": [TARGET_MODEL],
                "fallback_models": [],
                "used_fallback": False,
                "route_score": 100,
                "route_hits": [
                    "gemini_monomodel_strict",
                    "cloud_only",
                ],
                "gpu_policy": "disabled_for_ezzio",
                "num_gpu": 0,
                "ok": True,
            }

        except Exception as exc:
            last_error = str(exc)
            continue

    detail = (
        f" Dernière erreur : {last_error}"
        if last_error
        else ""
    )

    return _fail_closed(
        "[FAIL-CLOSED] Gemini unavailable : "
        f"épuisement du pool multi-clés sur {TARGET_MODEL} "
        f"({attempted_keys} clé(s) testée(s)). "
        "Aucune inférence locale autorisée."
        + detail
    )
