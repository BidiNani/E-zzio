"""E-ZZIO Cloud Brain Broker.

Contrat centralisé Cloud-Only.
Aucune inférence locale autorisée dans ce module.
"""

import json
import urllib.request
from typing import Any, Dict

from core.security.unified_vault import key_vault


TARGET_MODEL = "gemini-3.5-flash-lite"


def build_system_prompt() -> str:
    from pathlib import Path
    root = Path(r"G:/AI/E-zzio")
    parts = []

    persona_txt = root / "registry" / "persona.txt"
    if persona_txt.exists():
        try:
            content = persona_txt.read_text(encoding="utf-8").strip()
            if content:
                parts.append(content)
        except Exception:
            pass

    personality_dir = root / "registry" / "personality"
    for filename in ("identity.md", "speech.md", "traits.md", "lore.md"):
        fpath = personality_dir / filename
        if fpath.exists():
            try:
                content = fpath.read_text(encoding="utf-8").strip()
                if content:
                    header = "### [REGISTRE : " + filename.upper() + "]"
                    parts.append(header + "
" + content)
            except Exception:
                pass

    if not parts:
        return "Tu es E-ZZIO, l'âme numérique souveraine et compagnon de code de BidiNani."

    return "

".join(parts)



def _fail_closed(message: str) -> Dict[str, Any]:
    return {
        "response": message,
        "answer": message,
        "message": message,
        "content": message,
        "reply": message,
        "model": "none",
        "primary_model": "none",
        "deep_model": "none",
        "attempted_models": [],
        "fallback_models": [],
        "used_fallback": False,
        "route_score": 0,
        "route_hits": ["cloud_fail_closed"],
        "gpu_policy": "disabled_for_ezzio",
        "num_gpu": 0,
        "ok": False,
    }


def cloud_chat(
    text: str,
    session_id: str = "",
    system_prompt: str = "",
    speed: str = "fast",
    provider: str = "gemini",
) -> Dict[str, Any]:
    """
    Interface Cloud canonique.

    provider est accepté pour compatibilité avec ezzio_master.py.
    Aucun autre provider n'est autorisé.
    """

    provider_normalized = str(provider or "gemini").strip().lower()

    if provider_normalized != "gemini":
        return _fail_closed(
            f"[FAIL-CLOSED] Provider Cloud interdit : {provider_normalized}. "
            "Seul Gemini est autorisé."
        )

    sys_p = system_prompt or build_system_prompt()

    try:
        keys = key_vault.get_all_keys_for_provider("gemini")
    except Exception as exc:
        return _fail_closed(
            f"[FAIL-CLOSED] Impossible d'interroger le Vault Gemini : {exc}"
        )

    if not keys:
        return _fail_closed(
            "[FAIL-CLOSED] Gemini unavailable : "
            "Aucune clé Gemini valide trouvée dans le Vault multi-clés."
        )

    payload = {
        "contents": [
            {
                "role": "user",
                "parts": [
                    {
                        "text": (
                            f"Instructions :\n{sys_p}\n\n"
                            f"Requête :\n{text}"
                        )
                    }
                ],
            }
        ]
    }

    data = json.dumps(payload).encode("utf-8")

    last_error = None
    attempted_keys = 0

    for key in keys:
        attempted_keys += 1

        url = (
            "https://generativelanguage.googleapis.com/"
            f"v1beta/models/{TARGET_MODEL}:generateContent?key={key}"
        )

        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )

        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                res_json = json.loads(
                    resp.read().decode("utf-8")
                )

            candidates = res_json.get("candidates", [])

            if not candidates:
                last_error = "Gemini n'a retourné aucun candidate."
                continue

            parts = (
                candidates[0]
                .get("content", {})
                .get("parts", [])
            )

            reply = "".join(
                str(part.get("text", ""))
                for part in parts
                if isinstance(part, dict)
            ).strip()

            if not reply:
                last_error = "Gemini a retourné une réponse vide."
                continue

            return {
                "response": reply,
                "answer": reply,
                "message": reply,
                "content": reply,
                "reply": reply,
                "model": TARGET_MODEL,
                "primary_model": TARGET_MODEL,
                "deep_model": TARGET_MODEL,
                "attempted_models": [TARGET_MODEL],
                "fallback_models": [],
                "used_fallback": False,
                "route_score": 100,
                "route_hits": [
                    "gemini_monomodel_strict",
                    "cloud_only",
                ],
                "gpu_policy": "disabled_for_ezzio",
                "num_gpu": 0,
                "ok": True,
            }

        except Exception as exc:
            last_error = str(exc)
            continue

    detail = (
        f" Dernière erreur : {last_error}"
        if last_error
        else ""
    )

    return _fail_closed(
        "[FAIL-CLOSED] Gemini unavailable : "
        f"épuisement du pool multi-clés sur {TARGET_MODEL} "
        f"({attempted_keys} clé(s) testée(s)). "
        "Aucune inférence locale autorisée."
        + detail
    )
