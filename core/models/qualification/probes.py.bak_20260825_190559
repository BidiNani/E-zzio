"""E-ZZIO safe model qualification probes with strict JSON contract."""

from __future__ import annotations

import json
import re
import time
from typing import Any

import httpx

EXPECTED_JSON = {"status": "ok"}
EXPECTED_JSON_COMPACT = '{"status":"ok"}'

def _extract_content(data: dict[str, Any]) -> str:
    choices = data.get("choices")
    if not isinstance(choices, list) or not choices:
        return ""

    first = choices[0]
    if not isinstance(first, dict):
        return ""

    message = first.get("message")
    if isinstance(message, dict):
        content = message.get("content")
        if content is not None:
            return str(content)

        reasoning = message.get("reasoning_content")
        if reasoning is not None:
            return str(reasoning)

    text = first.get("text")
    if text is not None:
        return str(text)

    return ""

def _clean_content(raw_content: str) -> str:
    cleaned = re.sub(
        r"<think>.*?</think>",
        "",
        raw_content,
        flags=re.DOTALL | re.IGNORECASE,
    ).strip()

    cleaned = re.sub(
        r"^```json\s*",
        "",
        cleaned,
        flags=re.IGNORECASE,
    )

    cleaned = re.sub(
        r"\s*```$",
        "",
        cleaned,
    )

    return cleaned.strip()

def _strict_contract_match(cleaned: str) -> bool:
    if cleaned == EXPECTED_JSON_COMPACT:
        return True

    if cleaned == '{"status": "ok"}':
        return True

    try:
        parsed = json.loads(cleaned)
    except (TypeError, ValueError, json.JSONDecodeError):
        return False

    return parsed == EXPECTED_JSON

async def openai_compatible_probe(
    *,
    endpoint: str,
    api_key: str,
    model_id: str,
    timeout: float = 25.0,
) -> dict[str, Any]:
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }

    payload = {
        "model": model_id,
        "messages": [
            {
                "role": "system",
                "content": (
                    "You are being qualification-tested. "
                    "The word JSON is required. "
                    "Return JSON only."
                ),
            },
            {
                "role": "user",
                "content": (
                    'Return this exact JSON object and nothing else: '
                    '{"status":"ok"}'
                ),
            },
        ],
        "temperature": 0.0,
        "max_tokens": 64,
        "response_format": {"type": "json_object"},
    }

    started = time.perf_counter()
    response: httpx.Response | None = None
    raw_content = ""

    try:
        async with httpx.AsyncClient(timeout=timeout) as client:
            response = await client.post(
                endpoint,
                headers=headers,
                json=payload,
            )

        latency_ms = (time.perf_counter() - started) * 1000.0

        result: dict[str, Any] = {
            "latency_ms": round(latency_ms, 2),
            "http_status": response.status_code,
            "success": response.is_success,
            "structured_json": False,
            "content_available": False,
            "exact_contract_match": False,
            "error_detail": None,
        }

        if not response.is_success:
            result["error_detail"] = response.text[:1000]
            return result

        data = response.json()
        if not isinstance(data, dict):
            result["error_detail"] = "invalid_response_root"
            return result

        raw_content = _extract_content(data)
        cleaned = _clean_content(raw_content)

        result["content_available"] = bool(cleaned)

        if not cleaned:
            result["error_detail"] = "empty_model_content"
            return result

        try:
            parsed = json.loads(cleaned)
            result["structured_json"] = (
                isinstance(parsed, dict)
                and parsed.get("status") == "ok"
            )
        except (TypeError, ValueError, json.JSONDecodeError):
            result["structured_json"] = False

        result["exact_contract_match"] = _strict_contract_match(cleaned)

        if not result["exact_contract_match"]:
            result["error_detail"] = "output_contract_violation"

        return result

    except (
        httpx.RequestError,
        ValueError,
        KeyError,
        IndexError,
        TypeError,
        json.JSONDecodeError,
    ) as exc:
        return {
            "latency_ms": round(
                (time.perf_counter() - started) * 1000.0,
                2,
            ),
            "http_status": (
                response.status_code
                if response is not None
                else None
            ),
            "success": False,
            "structured_json": False,
            "content_available": bool(raw_content.strip()),
            "exact_contract_match": False,
            "error_detail": str(exc),
        }