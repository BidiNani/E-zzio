{
  "stages": [
    {
      "level": "LEVEL_1_TARGETED",
      "trigger": "Modification unitaire d'un module",
      "command": "pytest tests/test_<module>.py",
      "time_budget": "< 2s"
    },
    {
      "level": "LEVEL_2_CONTRACT_IMPACT",
      "trigger": "Modification d'une interface ou d'un connecteur",
      "command": "pytest tests/ -k 'contract or gateway'",
      "time_budget": "< 8s"
    },
    {
      "level": "LEVEL_3_FULL_GATE",
      "trigger": "Porte de validation finale avant commit/clôture",
      "command": "pytest (330 tests complets)",
      "time_budget": "~35s"
    }
  ]
}