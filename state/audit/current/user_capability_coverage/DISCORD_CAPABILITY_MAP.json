{
  "interface": "Discord Bot (core/integrations/discord/discord_client.py)",
  "prefix": "!bidi",
  "supported_actions": [
    {
      "action": "chat",
      "command": "!bidi <message>",
      "pipeline": "DiscordCommandRouter -> TaskEngine / ModelRouter",
      "output": "Direct reply"
    },
    {
      "action": "status",
      "command": "!bidi status",
      "pipeline": "DiscordWatchdog -> Health check",
      "output": "Bot status embed"
    },
    {
      "action": "memory_recall",
      "command": "!bidi recall <query>",
      "pipeline": "UnifiedMemoryGateway.search_memory",
      "output": "FTS5 message history"
    },
    {
      "action": "attachments",
      "command": "File upload in channel",
      "pipeline": "UniversalFileReader / Perception",
      "output": "Parsed document summary"
    }
  ],
  "permissions": "Guardian Role-Based Guard (permission_guard.py)",
  "status": "OPERATIONAL"
}