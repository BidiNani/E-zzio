{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidenceRuleToolRecord",
  "description": "E-ZZIO Standard Constitutionnel de Fiche de Preuve d'Outil/Capacité",
  "type": "object",
  "required": [
    "tool_id",
    "source_url",
    "commit_or_version",
    "license_code",
    "license_weights",
    "install_path",
    "file_hashes",
    "dependencies",
    "hardware_requirements",
    "hardware_fit",
    "install_status",
    "execution_status",
    "test_status",
    "runtime_status",
    "evidence_paths",
    "final_classification"
  ],
  "properties": {
    "tool_id": { "type": "string" },
    "source_url": { "type": "string" },
    "commit_or_version": { "type": "string" },
    "license_code": { "type": "string" },
    "license_weights": { "type": "string" },
    "install_path": { "type": "string" },
    "file_hashes": { "type": "string" },
    "dependencies": { "type": "string" },
    "hardware_requirements": { "type": "string" },
    "hardware_fit": {
      "type": "string",
      "enum": ["COMPATIBLE", "PARTIAL", "INCOMPATIBLE", "UNVERIFIED"]
    },
    "install_status": {
      "type": "string",
      "enum": ["DOCUMENTED", "DISCOVERED", "SOURCE_VERIFIED", "INSTALLED"]
    },
    "execution_status": { "type": "string" },
    "test_status": { "type": "string" },
    "runtime_status": { "type": "string" },
    "evidence_paths": { "type": "string" },
    "final_classification": {
      "type": "string",
      "enum": [
        "DOCUMENTED",
        "DISCOVERED",
        "SOURCE_VERIFIED",
        "INSTALLED",
        "EXECUTED",
        "TEST_VERIFIED",
        "RUNTIME_VERIFIED",
        "PROVEN",
        "UNVERIFIED",
        "FALSE"
      ]
    }
  }
}
