<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0f19">

    <!-- Sovereign Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#111827"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="E-ZZIO SOUVERAIN"
            android:textColor="#6366f1"
            android:textStyle="bold"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConfigServer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="SERVEUR"
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:backgroundTint="#374151" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="ACTUALISER"
            android:textSize="11sp"
            android:textColor="#ffffff"
            android:backgroundTint="#4f46e5" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Offline / Connection Error Overlay -->
        <LinearLayout
            android:id="@+id/errorOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0b0f19"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-ZZIO DISCONNECTED"
                android:textColor="#ef4444"
                android:textStyle="bold"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Impossible de joindre le Master Governor.\nVérifiez l'adresse ou le réseau."
                android:textColor="#9ca3af"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="RÉESSAYER"
                android:backgroundTint="#6366f1" />

            <Button
                android:id="@+id/btnChangeUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="MODIFIER L'ADRESSE DU SERVEUR"
                android:textColor="#9ca3af"
                android:backgroundTint="#1f2937" />
        </LinearLayout>

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
