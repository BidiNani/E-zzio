#!/bin/sh
# E-ZZIO pre-commit - BLOQUANT
set -e

PY=".venv/Scripts/python.exe"
[ -f "$PY" ] || PY=".venv/bin/python"
[ -f "$PY" ] || { echo "[pre-commit] venv introuvable"; exit 1; }

echo "[pre-commit] ruff check..."
"$PY" -m ruff check . --no-cache

echo "[pre-commit] pytest unit tests..."
"$PY" -m pytest tests/ \
    --ignore=tests/integration \
    --ignore=tests/test_web_ui_e2e.py \
    -q -x -m "not slow and not visual and not hardware" --tb=line

echo "[pre-commit] OK"