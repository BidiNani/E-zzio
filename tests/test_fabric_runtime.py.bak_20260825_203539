"""E-ZZIO Autonomous Model Fabric — Certification Quarantaine Runtime v4.1."""

from __future__ import annotations

import asyncio
import sys
from pathlib import Path

# ---------------------------------------------------------------------------
# Bootstrap hermétique de sys.path
# ---------------------------------------------------------------------------
PROJECT_ROOT = Path(r"G:\AI\E-zzio").resolve()
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from dotenv import load_dotenv

from core.models.fabric import build_fabric

# Résolution résiliente de ProviderExhaustedError
try:
    from core.models.router import ProviderExhaustedError
except ImportError:
    try:
        from core.models.fabric import ProviderExhaustedError
    except ImportError:
        try:
            from core.exceptions import ProviderExhaustedError
        except ImportError:
            class ProviderExhaustedError(Exception):
                """Fallback de compatibilité pour exception de fail-closed."""
                pass


def check_exact_contract(content: str) -> bool:
    return content.strip() == "OK"


async def main() -> None:
    project_root = PROJECT_ROOT
    load_dotenv(project_root / ".env")

    print("")
    print("=" * 64)
    print(" E-ZZIO — CERTIFICATION QUARANTAINE RUNTIME v4.1")
    print("=" * 64)
    print("")

    # PRECHECK
    print("[PRECHECK] Vérification du câblage runtime...")
    fabric = build_fabric(project_root=project_root)
    assert hasattr(fabric, "quarantine_runtime_violation"), (
        "FAIL: fabric.quarantine_runtime_violation est absente du runtime."
    )
    print(" -> [PASS] build_fabric() et méthode de quarantaine détectés.\n")

    # [1/4] DISCOVERY
    print("[1/4] Découverte des catalogues distants...")
    discovery_res = await fabric.discover()
    for provider, count in discovery_res.items():
        print(f" - {provider:<14}: {count} modèle(s) détecté(s)")

    # [2/4] QUALIFICATION
    print("\n[2/4] Qualification des candidats prioritaires...")
    qual_res = await fabric.qualify()
    for item in qual_res:
        model_id = f"{item['provider']}/{item['model_id']}"
        status = "[QUALIFIÉ]" if item.get("qualified") else "[ÉCHEC]"
        print(
            f" - {status} {model_id} | Palier: {item['tier']} | "
            f"Latence: {item['latency_ms']:.2f} ms | Score: {item['score']}/100"
        )
        if not item.get("qualified"):
            print(f"      Motifs: {item.get('failures')}")

    # [3/4] ACTIVATION
    print("\n[3/4] Activation exclusive dans le registre dynamique...")
    transitions = fabric.activate_qualified(qual_res)
    for tr in transitions:
        print(
            f" - Transition : {tr['model_id']:<36} "
            f"[{tr['old_state']} -> {tr['new_state']}] (Tier: {tr['tier']})"
        )

    initial_active = fabric.registry.active()
    print(f"\n Contrôle registre initial : {len(initial_active)} modèle(s) ACTIVE")
    for model in initial_active:
        print(f" * ACTIF : {model.provider}/{model.model_id} | Palier: {model.tier} | Latence: {model.latency_ms:.2f} ms")

    # [4/4] RUNTIME & SCÉNARIO DE RUPTURE DÉTERMINISTE
    print("\n[4/4] Inférence cognitive & certification du cycle de vie...")

    # TEST A : FAST
    print("\n--- TEST A : Palier FAST (Inférence réelle) ---")
    active_fast = [m for m in initial_active if m.tier == "FAST"]
    assert active_fast, "FAIL: Aucun modèle FAST actif dans le registre."

    response_fast = await fabric.router.execute(
        messages=[{"role": "user", "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK."}],
        tier="FAST",
        temperature=0.0,
    )
    content_fast = str(response_fast.get("content", ""))
    assert check_exact_contract(content_fast), f"Contrat FAST violé : {content_fast!r}"
    print(" -> [PASS] Contrat FAST validé ('OK')")
    print(f"    Modèle utilisé : {response_fast.get('provider')}/{response_fast.get('model')}")

    # TEST B : MID
    print("\n--- TEST B : Palier MID (Quarantaine déterministe) ---")
    active_mid_initial = [m for m in initial_active if m.tier == "MID"]

    if not active_mid_initial:
        print(" -> [WARN] Aucun modèle MID qualifié au départ. Vérification Fail-Closed...")
        try:
            await fabric.router.execute(
                messages=[{"role": "user", "content": "Ping"}],
                tier="MID",
                temperature=0.0,
            )
            raise AssertionError("FAIL: Le routeur aurait dû lever ProviderExhaustedError.")
        except ProviderExhaustedError:
            print(" -> [PASS] Fail-Closed initial validé.")
            print("\n[WARN] Certification de quarantaine non exercée : aucun MID actif initial.")
            sys.exit(2)

    target_mid = active_mid_initial[0]
    target_provider = target_mid.provider
    target_model = target_mid.model_id

    target_entry = fabric.registry.find(target_provider, target_model)
    assert target_entry is not None, "FAIL: Entrée MID cible absente du registre."

    saved_lifecycle = target_entry.lifecycle
    saved_tier = target_entry.tier
    saved_failure_count = int(getattr(target_entry, "failure_count", 0))

    print(f" -> Cible MID : {target_provider}/{target_model}")
    print(f"    lifecycle     = {saved_lifecycle}")
    print(f"    tier          = {saved_tier}")
    print(f"    failure_count = {saved_failure_count}")

    try:
        # Simulation d'une violation contrôlée
        simulated_bad_payload = "**Raisonnement**\nTexte non sollicité.\nOK"
        print(f"\n -> Injection d'une violation contrôlée : {simulated_bad_payload[:30]!r}...")

        quarantine_result = fabric.quarantine_runtime_violation(
            provider=target_provider,
            model_id=target_model,
            tier="MID",
            reason=f"simulated_contract_violation: received={simulated_bad_payload!r}",
        )
        assert quarantine_result is True, "FAIL: quarantine_runtime_violation() a retourné False."
        print(" -> [PASS] Quarantaine appliquée et registre mis à jour.")

        # Rechargement runtime
        print("\n--- RECONSTRUCTION DU RUNTIME & CONTRÔLE DISQUE ---")
        reloaded_fabric = build_fabric(project_root=project_root)

        quarantined_entry = reloaded_fabric.registry.find(target_provider, target_model)
        assert quarantined_entry is not None, "FAIL: Modèle quarantiné introuvable après reload."
        assert quarantined_entry.lifecycle == "QUARANTINED", (
            f"FAIL: lifecycle attendu 'QUARANTINED', obtenu {quarantined_entry.lifecycle!r}"
        )
        assert quarantined_entry.tier == "UNQUALIFIED", (
            f"FAIL: tier attendu 'UNQUALIFIED', obtenu {quarantined_entry.tier!r}"
        )

        failures_after = int(getattr(quarantined_entry, "failure_count", 0))
        assert failures_after == saved_failure_count + 1, (
            f"FAIL: failure_count incorrect. Attendu={saved_failure_count + 1}, obtenu={failures_after}"
        )
        print(" -> [PASS] lifecycle = QUARANTINED | tier = UNQUALIFIED")
        print(f" -> [PASS] failure_count incrémenté : {saved_failure_count} -> {failures_after}")

        reloaded_active = reloaded_fabric.registry.active()
        reloaded_active_ids = [(m.provider, m.model_id) for m in reloaded_active]
        assert (target_provider, target_model) not in reloaded_active_ids, (
            f"FAIL CRITIQUE: {target_provider}/{target_model} est toujours présent dans active() !"
        )
        print(" -> [PASS] Modèle quarantiné exclu du registre actif.")

        # Test MID #2 sur le nouveau runtime
        print("\n--- TEST B2 : MID après quarantaine (Sur reloaded_fabric.router) ---")
        active_mid_after = [m for m in reloaded_active if m.tier == "MID"]

        try:
            response_mid_2 = await reloaded_fabric.router.execute(
                messages=[{"role": "user", "content": "Ping"}],
                tier="MID",
                temperature=0.0,
            )
            used_provider = str(response_mid_2.get("provider", ""))
            used_model = str(response_mid_2.get("model", ""))

            assert (used_provider, used_model) in [(m.provider, m.model_id) for m in active_mid_after], (
                f"FAIL: Repli vers un modèle non certifié MID : {used_provider}/{used_model}"
            )
            assert (used_provider != target_provider or used_model != target_model), (
                "FAIL CRITIQUE: Le routeur a réutilisé le modèle quarantiné !"
            )
            print(f" -> [PASS REPLI QUALIFIÉ] Routage vers modèle de secours conforme : {used_provider}/{used_model}")

        except ProviderExhaustedError as exc:
            assert len(active_mid_after) == 0, (
                "FAIL: ProviderExhaustedError levée alors qu'il reste des modèles MID actifs."
            )
            print(f" -> [PASS FAIL-CLOSED PROUVÉ] Aucun MID disponible, rejet propre : {exc}")

        # Rapport officiel
        print("\n" + "=" * 64)
        print(" E-ZZIO — RAPPORT OFFICIEL DE CERTIFICATION")
        print("=" * 64)
        print(" [PASS] Bootstrap et import runtime")
        print(" [PASS] Contrat FAST nominal")
        print(" [PASS] Quarantaine runtime déterministe")
        print(" [PASS] Statut QUARANTINED et tier UNQUALIFIED")
        print(" [PASS] failure_count incrémenté (N + 1)")
        print(" [PASS] Persistance disque et reconstruction complète")
        print(" [PASS] Exclusion garantie du modèle des actifs")
        print(" [PASS] Repli qualifié / Fail-Closed confirmé")
        print("=" * 64)
        print("VERDICT : CERTIFIED")

    finally:
        print("\n[NETTOYAGE] Restauration de l'état initial du modèle cible...")
        restore_fabric = build_fabric(project_root=project_root)
        entry_restore = restore_fabric.registry.find(target_provider, target_model)
        if entry_restore is not None:
            entry_restore.lifecycle = saved_lifecycle
            entry_restore.tier = saved_tier
            entry_restore.failure_count = saved_failure_count
            restore_fabric.registry.save()
            print(f" -> [PASS] Registre restauré : {target_provider}/{target_model} (lifecycle={saved_lifecycle})")
        else:
            print(" -> [WARN] Impossible de retrouver l'entrée pour restauration.")


if __name__ == "__main__":
    asyncio.run(main())