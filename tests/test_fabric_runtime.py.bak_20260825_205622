class Scorecard:
def **init**(self) -> None:
self.results: dict[str, dict[str, str]] = {}

```
def record(
    self,
    test_id: str,
    status: str,
    details: str = "",
) -> None:
    self.results[test_id] = {
        "status": status,
        "details": details,
    }

    print(
        f" [{status:<13}] {test_id:<8} : {details}"
    )

def count(self, status: str) -> int:
    return sum(
        1
        for value in self.results.values()
        if value["status"] == status
    )
```

def model_key(model) -> tuple[str, str]:
return model.provider, model.model_id

def snapshot_registry(fabric) -> dict:
snapshot = {}

```
for model in fabric.registry.all():
    key = model_key(model)

    state = {}
    for field in (
        "lifecycle",
        "tier",
        "failure_count",
        "historical_failures",
        "rehabilitation_count",
        "last_quarantine_at",
        "last_quarantine_reason",
        "last_quarantine_operator",
        "rehabilitated_at",
        "rehabilitated_by",
        "rehabilitation_reason",
        "updated_at",
    ):
        state[field] = copy.deepcopy(
            getattr(model, field, None)
        )

    snapshot[key] = state

return snapshot
```

def restore_registry(fabric, snapshot: dict) -> None:
for key, expected in snapshot.items():
provider, model_id = key
entry = fabric.registry.find(provider, model_id)

```
    if entry is None:
        raise AssertionError(
            f"Modèle disparu du registre : {provider}/{model_id}"
        )

    for field, value in expected.items():
        if hasattr(entry, field):
            setattr(entry, field, copy.deepcopy(value))

fabric.registry.save()
```

def verify_registry(fabric, snapshot: dict) -> None:
current = snapshot_registry(fabric)

```
if set(current) != set(snapshot):
    raise AssertionError(
        "Ensemble de modèles différent après restauration."
    )

for key, expected in snapshot.items():
    actual = current[key]

    for field, expected_value in expected.items():
        actual_value = actual.get(field)

        if actual_value != expected_value:
            raise AssertionError(
                f"Restauration incorrecte pour {key} / {field}: "
                f"attendu={expected_value!r}, "
                f"obtenu={actual_value!r}"
            )
