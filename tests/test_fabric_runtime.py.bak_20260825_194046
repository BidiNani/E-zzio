"""E-ZZIO Autonomous Model Fabric — Banc de certification stricte de quarantaine runtime."""

from __future__ import annotations

import asyncio
import sys
from pathlib import Path
from dotenv import load_dotenv

from core.models.fabric import build_fabric
from core.models.exceptions import ProviderExhaustedError


def check_exact_contract(content: str) -> bool:
    """Valide strictement le contrat exact sans effet de bord."""
    return content.strip() == "OK"


async def main() -> None:
    project_root = Path(r"G:\AI\E-zzio")
    load_dotenv(project_root / ".env")

    print("=== Démarrage du banc d'essai E-ZZIO Fabric (Certification) ===\n")
    fabric = build_fabric(project_root=project_root)

    # [1/4] Découverte
    print("[1/4] Découverte des catalogues distants...")
    discovery_res = await fabric.discover()
    for prov, count in discovery_res.items():
        print(f" - {prov:<14}: {count} modèle(s) détecté(s)")

    # [2/4] Qualification
    print("\n[2/4] Qualification des candidats prioritaires...")
    qual_res = await fabric.qualify()
    for item in qual_res:
        m_id = f"{item['provider']}/{item['model_id']}"
        statut = "[QUALIFIÉ]" if item.get("qualified") else "[ÉCHEC]"
        print(
            f" - {statut} {m_id} | Palier: {item['tier']} | "
            f"Latence: {item['latency_ms']:.2f} ms | Score: {item['score']}/100"
        )
        if not item.get("qualified"):
            print(f"      Motifs: {item.get('failures')}")

    # [3/4] Activation
    print("\n[3/4] Activation exclusive dans le registre dynamique...")
    transitions = fabric.activate_qualified(qual_res)
    for tr in transitions:
        print(
            f" - Transition : {tr['model_id']:<36} "
            f"[{tr['old_state']} -> {tr['new_state']}] (Tier: {tr['tier']})"
        )

    initial_active = fabric.registry.active()
    print(f"\n Contrôle registre initial : {len(initial_active)} modèle(s) ACTIVE")
    for m in initial_active:
        print(f" * ACTIF : {m.provider}/{m.model_id} | Palier: {m.tier} | Latence: {m.latency_ms:.2f} ms")

    # [4/4] Inférence cognitive & Scénarios de rupture
    print("\n[4/4] Inférence cognitive & Scénarios de certification...")

    # --- TEST A : FAST ---
    print("\n--- TEST A : Palier FAST ---")
    active_fast = [m for m in initial_active if m.tier == "FAST"]
    assert active_fast, "FAIL: Aucun modèle FAST actif dans le registre."

    response_fast = await fabric.router.execute(
        messages=[{"role": "user", "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK."}],
        tier="FAST",
        temperature=0.0,
    )
    content_fast = str(response_fast.get("content", ""))
    if not check_exact_contract(content_fast):
        fabric.quarantine_runtime_violation(
            provider=str(response_fast.get("provider")),
            model_id=str(response_fast.get("model")),
            tier="FAST",
            reason=f"fast_violation: {content_fast[:200]!r}",
        )
        raise AssertionError(f"Contrat FAST violé : attendu='OK', reçu={content_fast!r}")

    print(" -> [PASS] Contrat FAST validé ('OK')")
    print(f"    Modèle utilisé : {response_fast.get('provider')}/{response_fast.get('model')}")

    # --- TEST B : MID #1 (Scénario de rupture) ---
    print("\n--- TEST B : Palier MID #1 ---")
    active_mid_initial = [m for m in initial_active if m.tier == "MID"]
    if not active_mid_initial:
        print(" -> [FAIL-CLOSED] Aucun modèle MID qualifié au départ.")
        try:
            await fabric.router.execute(
                messages=[{"role": "user", "content": "Ping"}],
                tier="MID",
                temperature=0.0,
            )
            raise AssertionError("FAIL: Le routeur aurait dû lever ProviderExhaustedError.")
        except ProviderExhaustedError:
            print(" -> [PASS] Fail-Closed initial validé.")
            print("\n[BLOCAGE] Certification de quarantaine non exercée : aucun modèle MID actif initial.")
            sys.exit(2)

    response_mid_1 = await fabric.router.execute(
        messages=[{"role": "user", "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK."}],
        tier="MID",
        temperature=0.0,
    )
    routed_prov = str(response_mid_1.get("provider", ""))
    routed_mod = str(response_mid_1.get("model", ""))
    content_mid_1 = str(response_mid_1.get("content", ""))

    print(f" -> Modèle réellement routé MID #1 : {routed_prov}/{routed_mod}")

    # 1. Assertion d'appartenance initiale
    active_mid_ids = [(m.provider, m.model_id) for m in active_mid_initial]
    assert (routed_prov, routed_mod) in active_mid_ids, (
        f"FAIL: Le modèle routé ({routed_prov}/{routed_mod}) n'appartenait pas aux modèles MID actifs initiaux !"
    )
    print(" -> [PASS] Modèle routé validé dans le registre MID initial.")

    # 2. Exigence de la rupture contractuelle
    is_valid_contract = check_exact_contract(content_mid_1)
    if is_valid_contract:
        print(" -> [WARN] Le modèle MID #1 a répondu strictement 'OK'.")
        print(" -> [WARN] Le scénario de violation contractuelle n'a pas été déclenché.")
        print("\n[VERDICT] CERTIFICATION INCOMPLÈTE : Rupture non exercée.")
        sys.exit(3)

    print(f" -> [PASS] Violation contractuelle détectée : reçu={content_mid_1[:150]!r}")

    # 3. Application de la quarantaine
    quarantine_success = fabric.quarantine_runtime_violation(
        provider=routed_prov,
        model_id=routed_mod,
        tier="MID",
        reason=f"exact_ok_violation: received={content_mid_1[:300]!r}",
    )
    assert quarantine_success is True, "FAIL: Échec de l'appel quarantine_runtime_violation."
    print(" -> [PASS] Quarantaine appliquée et persistée sur le disque.")

    # --- RECONSTRUCTION & RELOAD ---
    print("\n--- RECONSTRUCTION DU RUNTIME & CONTRÔLE REGISTRE ---")
    reloaded_fabric = build_fabric(project_root=project_root)
    quarantined_entry = reloaded_fabric.registry.find(routed_prov, routed_mod)

    assert quarantined_entry is not None, "Entrée introuvable dans le registre rechargé."
    assert quarantined_entry.lifecycle == "QUARANTINED", (
        f"Statut attendu 'QUARANTINED', obtenu : {quarantined_entry.lifecycle}"
    )
    assert quarantined_entry.tier == "UNQUALIFIED", (
        f"Tier attendu 'UNQUALIFIED', obtenu : {quarantined_entry.tier}"
    )

    reloaded_active = reloaded_fabric.registry.active()
    assert (routed_prov, routed_mod) not in [(m.provider, m.model_id) for m in reloaded_active], (
        f"FAIL: Le modèle {routed_prov}/{routed_mod} est encore présent dans le registre actif rechargé !"
    )
    print(f" -> [PASS] Persistance disque vérifiée : {routed_prov}/{routed_mod} est bien QUARANTINED et inactif.")

    # --- TEST B : MID #2 (Isolation et Fail-Closed / Repli) ---
    print("\n--- TEST B : Palier MID #2 (Sur reloaded_fabric.router) ---")
    try:
        response_mid_2 = await reloaded_fabric.router.execute(
            messages=[{"role": "user", "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK."}],
            tier="MID",
            temperature=0.0,
        )
        used_2_prov = str(response_mid_2.get("provider", ""))
        used_2_mod = str(response_mid_2.get("model", ""))

        # Si un repli répond, il doit impérativement être un AUTRE modèle MID qualifié et actif
        active_mid_reloaded = [m for m in reloaded_active if m.tier == "MID"]
        assert (used_2_prov, used_2_mod) in [(m.provider, m.model_id) for m in active_mid_reloaded], (
            f"FAIL: Repli sur un modèle non certifié MID : {used_2_prov}/{used_2_mod}"
        )
        assert (used_2_prov != routed_prov or used_2_mod != routed_mod), (
            f"FAIL CRITIQUE: Le routeur rechargé a utilisé le modèle en quarantaine ({used_2_prov}/{used_2_mod}) !"
        )
        print(f" -> [PASS REPLI QUALIFIÉ] Routage vers un second modèle MID certifié : {used_2_prov}/{used_2_mod}")

    except ProviderExhaustedError as exc:
        print(f" -> [PASS FAIL-CLOSED] Aucun modèle MID résiduel, rejet propre : {exc}")

    # --- RAPPORT FINAL DE CERTIFICATION ---
    print("\n" + "=" * 50)
    print("=== RAPPORT OFFICIEL DE CERTIFICATION E-ZZIO ===")
    print(" [PASS] Contrat d'inférence FAST")
    print(" [PASS] Appartenance initiale du modèle MID au registre")
    print(" [PASS] Détection formelle de violation contractuelle")
    print(" [PASS] Application de la quarantaine et incrément des échecs")
    print(" [PASS] Persistance sur disque du statut QUARANTINED")
    print(" [PASS] Reconstruction complète du runtime")
    print(" [PASS] Exclusion garantie du modèle quarantiné du routage MID")
    print(" [PASS] Cloisonnement Fail-Closed / Repli certifié")
    print("=" * 50)
    print("VERDICT : CERTIFIED")


if __name__ == "__main__":
    asyncio.run(main())