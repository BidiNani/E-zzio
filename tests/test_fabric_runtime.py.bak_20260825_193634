"""E-ZZIO Autonomous Model Fabric — Runtime Test Suite & Validation Gate."""

from __future__ import annotations

import asyncio
from pathlib import Path
from dotenv import load_dotenv

from core.models.fabric import build_fabric
from core.models.qualification.gate import QualificationGate
from core.models.exceptions import ProviderExhaustedError


def require_exact_ok(
    *,
    fabric,
    response: dict,
    tier: str,
) -> str:
    content = str(response.get("content", "")).strip()
    if content == "OK":
        return content

    provider = str(response.get("provider", ""))
    model_id = str(response.get("model", ""))
    fabric.quarantine_runtime_violation(
        provider=provider,
        model_id=model_id,
        tier=tier,
        reason=(
            "exact_ok_contract_violation: "
            f"received={content[:300]!r}"
        ),
    )
    raise AssertionError(
        "Contrat de réponse violé : "
        f"attendu='OK', reçu={content!r}"
    )


async def main() -> None:
    project_root = Path(r"G:\AI\E-zzio")
    load_dotenv(project_root / ".env")

    print("=== Démarrage du banc d'essai E-ZZIO Fabric ===\n")
    fabric = build_fabric(project_root=project_root)

    # [1/4] Découverte
    print("[1/4] Découverte des catalogues distants...")
    discovery_res = await fabric.discover()
    for prov, count in discovery_res.items():
        print(f" - {prov:<14}: {count} modèle(s) détecté(s)")

    # [2/4] Qualification
    print("\n[2/4] Qualification des candidats prioritaires...")
    qual_res = await fabric.qualify()
    for item in qual_res:
        m_id = f"{item['provider']}/{item['model_id']}"
        if item.get("qualified"):
            print(
                f" - Qualification de {m_id}...\n"
                f"   -> [QUALIFIÉ] Palier: {item['tier']} | "
                f"Latence: {item['latency_ms']:.2f} ms | "
                f"Score: {item['score']}/100"
            )
        else:
            print(
                f" - Qualification de {m_id}...\n"
                f"   -> [ÉCHEC] Palier: {item['tier']} | "
                f"Latence: {item['latency_ms']:.2f} ms | "
                f"Score: {item['score']}/100\n"
                f"      Motifs: {item.get('failures')}"
            )

    # [3/4] Activation
    print("\n[3/4] Activation exclusive dans le registre dynamique...")
    transitions = fabric.activate_qualified(qual_res)
    if not transitions:
        print(" - Aucune transition d'activation.")
    for tr in transitions:
        print(
            f" - Transition : {tr['model_id']:<36} "
            f"[{tr['old_state']} -> {tr['new_state']}] "
            f"(Tier: {tr['tier']})"
        )

    active_models = fabric.registry.active()
    print(f"\n Contrôle registre : {len(active_models)} modèle(s) ACTIVE")
    for m in active_models:
        print(f" * ACTIF : {m.provider}/{m.model_id} | Palier: {m.tier} | Latence: {m.latency_ms:.2f} ms")

    # [4/4] Inférence cognitive
    print("\n[4/4] Inférence cognitive avec validation du cloisonnement...")

    # --- Test A : Palier FAST ---
    print("\n --- Test A : Palier FAST (Attendu: SUCCÈS) ---")
    try:
        response_fast = await fabric.router.execute(
            messages=[
                {
                    "role": "user",
                    "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK.",
                }
            ],
            tier="FAST",
            temperature=0.0,
        )
        content_fast = require_exact_ok(
            fabric=fabric,
            response=response_fast,
            tier="FAST",
        )
        print(" -> Inférence FAST réussie !")
        print(f"    Fournisseur utilisé : {response_fast.get('provider')}")
        print(f"    Modèle actif        : {response_fast.get('model')}")
        print(f"    Créneau clé         : {response_fast.get('key_slot')}")
        print(f"    Réponse             : {content_fast}")
    except Exception as exc:
        print(f" -> ÉCHEC inattendu FAST : {exc}")
        raise

    # --- Test B : Palier MID ---
    print("\n --- Test B : Palier MID (Attendu: SUCCÈS si modèle MID actif) ---")
    try:
        response_mid = await fabric.router.execute(
            messages=[
                {
                    "role": "user",
                    "content": "Ping système E-ZZIO. Réponds uniquement par le mot OK.",
                }
            ],
            tier="MID",
            temperature=0.0,
        )
        content_mid = require_exact_ok(
            fabric=fabric,
            response=response_mid,
            tier="MID",
        )
        print(" -> Inférence MID réussie !")
        print(f"    Fournisseur utilisé : {response_mid.get('provider')}")
        print(f"    Modèle actif        : {response_mid.get('model')}")
        print(f"    Créneau clé         : {response_mid.get('key_slot')}")
        print(f"    Réponse             : {content_mid}")
    except ProviderExhaustedError as exc:
        print(f" -> [PASS - FAIL-CLOSED CONFORME] {exc}")
    except AssertionError as exc:
        print(f" -> ÉCHEC anormal MID : {exc}")
        raise
    except Exception as exc:
        print(f" -> ÉCHEC inattendu MID : {exc}")
        raise


if __name__ == "__main__":
    asyncio.run(main())