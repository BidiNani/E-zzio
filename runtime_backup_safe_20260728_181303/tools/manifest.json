{
  "manifest_version": 2,
  "memory_policy": {
    "store_failures": true,
    "store_tool_calls": true,
    "store_chat_content": false,
    "store_preferences": true,
    "min_execution_duration_sec": 0.0
  },
  "tools": {
    "filesystem.read": {
      "description": "Lit le contenu textuel d'un fichier.",
      "permission_level": 0,
      "executor": "python",
      "execution_mode": "internal",
      "timeout_sec": 5,
      "budget_cost": 1,
      "refund_on_failure": false,
      "sandbox": {
        "roots": ["."],
        "max_file_size_bytes": 2097152,
        "allowed_extensions": [".py", ".json", ".txt", ".md", ".ps1"]
      },
      "schema": {
        "required_args": ["path"],
        "types": {"path": "str"}
      }
    },
    "powershell.safe.execute": {
      "description": "Exécute une commande PowerShell sécurisée.",
      "permission_level": 1,
      "executor": "subprocess",
      "execution_mode": "external",
      "timeout_sec": 5,
      "budget_cost": 5,
      "refund_on_failure": false,
      "sandbox": {
        "roots": ["."],
        "allowed_commands": ["Get-ChildItem", "Echo"],
        "blocked_commands": ["Remove-Item"]
      },
      "schema": {
        "required_args": ["command"],
        "types": {"command": "str"}
      }
    },
    "system.powershell": {
      "description": "Alias historique de powershell.safe.execute.",
      "permission_level": 1,
      "executor": "subprocess",
      "execution_mode": "external",
      "timeout_sec": 5,
      "budget_cost": 5,
      "refund_on_failure": false,
      "sandbox": {
        "roots": ["."],
        "allowed_commands": ["Get-ChildItem", "Echo"],
        "blocked_commands": ["Remove-Item"]
      },
      "schema": {
        "required_args": ["command"],
        "types": {"command": "str"}
      }
    },
    "git.status": {
      "description": "Retourne le statut git du dépôt.",
      "permission_level": 0,
      "executor": "subprocess",
      "execution_mode": "external",
      "timeout_sec": 5,
      "budget_cost": 2,
      "refund_on_failure": false,
      "sandbox": {
        "roots": ["."],
        "allowed_commands": ["git"]
      },
      "schema": {
        "required_args": [],
        "types": {}
      }
    },
    "llm.cognitive_reflection": {
      "description": "Capacité interne réservée au sommeil. Analyse les épisodes pour générer des hypothèses.",
      "permission_level": 2,
      "executor": "python",
      "execution_mode": "internal",
      "timeout_sec": 120,
      "budget_cost": 20,
      "refund_on_failure": true,
      "sandbox": {
        "roots": ["."],
        "allowed_context": ["episodes", "failed_actions", "beliefs", "skills"],
        "forbidden_context": ["private_user_content", "raw_credentials"]
      },
      "schema": {
        "required_args": ["episodes_data"],
        "types": {"episodes_data": "list"}
      }
    }
  }
}