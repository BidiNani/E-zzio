# ============================================================
# E-ZZIO Cloud Brain Broker
# Ne mets jamais ce fichier dans Git.
# Copie/édite secrets/cloud_brain.env pour activer.
# ============================================================

# Sécurité globale : false par défaut.
EZZIO_CLOUD_ALLOW_SEND=true

# Mode :
# local_first  = local d'abord, cloud seulement si demandé/utile
# cloud_first  = cloud puis fallback local
# disabled     = cloud désactivé
EZZIO_CLOUD_MODE=local_first

# Quotas locaux conservateurs pour éviter de brûler les tiers gratuits.
# Ajuste selon les limites affichées par chaque console officielle.
EZZIO_CLOUD_DAILY_TOTAL_LIMIT=120
EZZIO_CLOUD_TIMEOUT_SEC=60
EZZIO_CLOUD_CACHE_TTL_SEC=86400

# Gemini API
# Crée une clé dans Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_LIMIT=50

# Groq API
# Crée une clé dans GroqCloud.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_DAILY_LIMIT=80

# OpenRouter API
# Utilise de préférence un modèle finissant par :free.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_DAILY_LIMIT=45

# En-têtes OpenRouter optionnels.
OPENROUTER_SITE_URL=http://127.0.0.1:8000
OPENROUTER_APP_NAME=E-ZZIO

# Confidentialité
EZZIO_CLOUD_REDACT_SECRETS=true
EZZIO_CLOUD_LOG_PROMPTS=false



