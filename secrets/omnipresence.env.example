DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_CHANNEL_ID=

META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_VERIFY_TOKEN=ezzio_local_verify_token_change_me
